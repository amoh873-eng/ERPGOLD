# ---------------------------------------------------------------
# ERPSystem production secrets - COPY TO .env AND CHMOD 600.
# Never commit this file. Never paste these values into chat/logs.
#
# deploy.sh validates this file before starting anything:
#   - POSTGRES_DB must be ERPCommercialDb (the approved template name)
#   - POSTGRES_PASSWORD / JWT_SECRET / COMPOSE_PROJECT_NAME must not
#     contain CHANGE_ME
#   - JWT_SECRET must be exactly 64 hex characters (32 bytes)
# ---------------------------------------------------------------

# Unique per installation. Must match [a-z0-9][a-z0-9_-]*.
# Used to namespace containers, networks and volumes so two installs
# never collide on the same Docker host.
COMPOSE_PROJECT_NAME=erp_customer_CHANGE_ME

# Host ports published by Caddy. Change them for a second install on
# the same machine; keep 443 when using a domain with HTTPS.
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_USER=erp_app
POSTGRES_PASSWORD=CHANGE_ME_REPLACE_WITH_OPENSSL_RAND_HEX_24
POSTGRES_DB=ERPCommercialDb

# HS256 JWT signing secret used by the API (must be 64 hex chars = 32 bytes)
JWT_SECRET=CHANGE_ME_REPLACE_WITH_OPENSSL_RAND_HEX_32

# ── First-run administrator ─────────────────────────────────────────────
# One-time setup token for /setup. Generate per installation:
#   openssl rand -hex 24
# After the administrator is created, set this to EMPTY and recreate the web
# container. There is NO default token in code: empty = setup disabled.
SETUP_TOKEN=

# ── Optional vendor / owner console ─────────────────────────────────────
# Leave ALL four empty to disable the owner console completely (no routes).
# To enable: generate a random path and a fresh owner password hash per customer.
#   openssl rand -hex 16          -> OWNER_SECRET_PATH
# Never reuse another customer's values or the values previously shipped in code.
OWNER_USERNAME=
OWNER_SECRET_PATH=
OWNER_PASSWORD_HASH=
OWNER_ALLOWED_IPS=

# Optional: comma-separated browser origins allowed by the API's CORS helper.
# Usually not needed (the mobile app is not a browser). Examples:
# ERP_API_CORS_ORIGINS=https://erp.example.com,https://pos.example.com
ERP_API_CORS_ORIGINS=
