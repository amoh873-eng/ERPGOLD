@* نموذج حوار لإنشاء فاتورة مبيعات جديدة (العميل + البنود) *@
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject IStringLocalizer<SharedResources> Loc
@inject IJSRuntime Js

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
            }
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid" @bind-Value="_customerId"
                               Label="@Loc["Customer"]" Required="true" RequiredError="@Loc["CustomerRequired"]"
                               Variant="Variant.Outlined">
                        @foreach (var c in _customers)
                        {
                            <MudSelectItem T="Guid" Value="@c.Id">@c.Code - @c.NameAr</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid" @bind-Value="_warehouseId"
                               Label="@Loc["Warehouse"]" Required="true" RequiredError="@Loc["WarehouseRequired"]"
                               Variant="Variant.Outlined">
                        @foreach (var w in _warehouses)
                        {
                            <MudSelectItem T="Guid" Value="@w.Id">@w.Code - @w.NameAr</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" @bind-Value="_invoiceType"
                               Label="@Loc["InvoiceType"]" Required="true" Variant="Variant.Outlined">
                        <MudSelectItem T="int" Value="1">@Loc["InvoiceTypeCash"]</MudSelectItem>
                        <MudSelectItem T="int" Value="2">@Loc["InvoiceTypeCredit"]</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" @bind-Value="_paymentMethod"
                               Label="@Loc["PaymentMethod"]" Required="true" Variant="Variant.Outlined">
                        <MudSelectItem T="int" Value="1">@Loc["PaymentCash"]</MudSelectItem>
                        <MudSelectItem T="int" Value="2">@Loc["PaymentCard"]</MudSelectItem>
                        <MudSelectItem T="int" Value="3">@Loc["PaymentOnAccount"]</MudSelectItem>
                        <MudSelectItem T="int" Value="4">@Loc["PaymentCheck"]</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_invoiceDate" Label="@Loc["InvoiceDate"]"
                                   Variant="Variant.Outlined" T="DateTime?" AutoClose="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField Culture="@CultureInfo.InvariantCulture" T="decimal" DecimalPlaces="2" Format="0.00" @bind-Value="_discountPercentage"
                                     Label="@Loc["DiscountPercent"]" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.subtitle2" Class="mt-4">@Loc["Lines"]</MudText>

            @if (_paymentMethod == 4)
            {
                <MudPaper Class="mb-3 pa-3" Style="background:#EEF2FF;border:1px solid #4F46E5;border-radius:10px;">
                    <MudText Typo="Typo.subtitle2" Style="font-weight:700;">@Loc["PaymentCheck"]</MudText>
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" @bind-Value="_checkNumber" Label="@Loc["CheckNumber"]" Required="true" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" @bind-Value="_checkBankName" Label="@Loc["CheckBankName"]" Required="true" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" @bind-Value="_checkBranch" Label="@Loc["CheckBranch"]" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="_checkIssueDate" Label="@Loc["CheckIssueDate"]" Variant="Variant.Outlined" T="DateTime?" AutoClose="true" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="_checkDueDate" Label="@Loc["CheckDueDate"]" Required="true" Variant="Variant.Outlined" T="DateTime?" AutoClose="true" Dense="true" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }

            @* ── مسح الباركود لإضافة سطر (نفس نمط فاتورة المشتريات) ── *@
            <MudPaper Class="mb-3 pa-3" Style="background:#F5F3FF;border:1px dashed #C4B5FD;border-radius:10px;">
                <div style="display:flex;align-items:center;gap:10px;">
                    <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Style="color:#6D5BD0;" />
                    <MudText Typo="Typo.subtitle2" Style="font-weight:700;flex:1;">@Loc["BarcodeReceive"]</MudText>
                </div>
                <MudTextField @ref="_scanInput"
                              @bind-Value="_scanTerm" T="string"
                              Placeholder="@Loc["BarcodeReceivePlaceholder"]"
                              Variant="Variant.Outlined" Dense="true" Class="mt-2"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true" OnKeyDown="HandleScanKeyDown" />
                @if (_lastScan is { } last)
                {
                    <MudAlert Severity="Severity.Success" Class="mt-2" Dense="true">@Loc["BarcodeScanOk", last.Name, last.QtyAdded, last.LineQty]</MudAlert>
                }
                else if (_scanFailed)
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2" Dense="true">@Loc["BarcodeScanNotFound"]</MudAlert>
                }
                <MudText Typo="Typo.caption" Class="pos-muted mt-1">@Loc["BarcodeReceiveHint"]</MudText>
            </MudPaper>

            @foreach (var line in _lines)
            {
                <MudGrid Class="mb-1 align-items-center">
                    <MudItem xs="12" sm="5">
                        <MudSelect T="Guid" Value="@line.ItemId"
                                   ValueChanged="@(id => OnLineItemChanged(line, id))"
                                   Label="@Loc["Item"]" Variant="Variant.Outlined" Dense="true">
                            @foreach (var it in _items)
                            {
                                <MudSelectItem T="Guid" Value="@it.Id">@it.Code - @it.NameAr</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudNumericField Culture="@CultureInfo.InvariantCulture" T="decimal" DecimalPlaces="2" Format="0.00" @bind-Value="line.Quantity"
                                         Label="@Loc["Qty"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudNumericField Culture="@CultureInfo.InvariantCulture" T="decimal" DecimalPlaces="2" Format="0.00" @bind-Value="line.UnitPrice"
                                         Label="@Loc["UnitPrice"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         ReadOnly="@(!_canEditPrice)"
                                         HelperText="@(_canEditPrice ? null : PriceLockHint)" />
                    </MudItem>
                    <MudItem xs="12" sm="2" Class="d-flex align-items-center">
                        <MudText Typo="Typo.caption" Style="color:var(--erp-muted)">
                            @Loc["SalesTax"]: @((LineTaxRate(line)).ToString("0.##"))% (@((LineTaxAmount(line)).ToString("N2")))
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" sm="1" Class="d-flex align-items-center">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       Color="Color.Error" OnClick="@(e => RemoveLine(line))" />
                    </MudItem>
                </MudGrid>
            }

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddLine" Class="mt-2">
                @Loc["AddLine"]
            </MudButton>

            <MudPaper Elevation="1" Class="pa-3 mt-4">
                <MudText Typo="Typo.body2">@Loc["SubTotal"]: @_subTotal.ToString("N2")</MudText>
                <MudText Typo="Typo.body2">@Loc["DiscountAmount"]: @_discountAmount.ToString("N2")</MudText>
                <MudText Typo="Typo.body2">@Loc["TaxAmount"]: @_taxAmount.ToString("N2")</MudText>
                <MudText Typo="Typo.h6" Class="mt-2">@Loc["Total"]: @_total.ToString("N2")</MudText>
            </MudPaper>

            <MudItem xs="12" Class="mt-3">
                <MudTextField @bind-Value="_note" Label="@Loc["Notes"]" Lines="2" Variant="Variant.Outlined" />
            </MudItem>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">@Loc["Cancel"]</MudButton>
        <MudButton OnClick="SubmitAsync" Variant="Variant.Filled" Color="Color.Primary">@Loc["SaveInvoice"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Inject] private ISalesInvoiceService InvoiceService { get; set; } = default!;
    [Inject] private ICustomerService CustomerService { get; set; } = default!;
    [Inject] private IWarehouseService WarehouseService { get; set; } = default!;
    [Inject] private IItemService ItemService { get; set; } = default!;

    private class LineEditor
    {
        public Guid ItemId { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
    }

    private MudForm? _form;
    private List<CustomerDto> _customers = new();
    private List<WarehouseDto> _warehouses = new();
    private List<ItemDto> _items = new();
    private List<LineEditor> _lines = new();

    private Guid _customerId;
    private Guid _warehouseId;
    private int _invoiceType = 1;
    private int _paymentMethod = 1;
    private string? _checkNumber;
    private string? _checkBankName;
    private string? _checkBranch;
    private DateTime? _checkIssueDate = DateTime.Today;
    private DateTime? _checkDueDate = DateTime.Today.AddMonths(1);
    private DateTime? _invoiceDate = DateTime.Today;
    private decimal _discountPercentage;
    private string? _note;
    private string? _error;

    // ── مسح الباركود (نفس نمط فاتورة المشتريات) ──
    private MudTextField<string>? _scanInput;
    private string _scanTerm = string.Empty;
    private bool _refocusScan;
    private bool _scanFailed;
    private LastScanInfo? _lastScan;
    private IJSObjectReference? _scanModule;
    private sealed record LastScanInfo(string Name, decimal QtyAdded, decimal LineQty);

    private decimal _subTotal => Math.Round(_lines.Sum(l => l.Quantity * l.UnitPrice), 2);
    private decimal _discountAmount => Math.Round(_subTotal * _discountPercentage / 100m, 2);
    // ضريبة المبيعات لكل سطر حسب نسبة الصنف (تُجمع دون تفصيل في هذا الحوار الداخلي).
    private decimal _taxAmount => Math.Round(_lines.Sum(l => LineTaxAmount(l)), 2);
    private decimal _total => _subTotal - _discountAmount + _taxAmount;

    private ItemDto? LineItem(LineEditor line) => _items.FirstOrDefault(i => i.Id == line.ItemId);
    private decimal LineTaxRate(LineEditor line) => LineItem(line)?.TaxRate ?? 0m;
    private decimal LineTaxAmount(LineEditor line)
    {
        var lineTotal = Math.Round(line.Quantity * line.UnitPrice, 2);
        var lineNet = _subTotal > 0m ? lineTotal - (lineTotal * _discountAmount / _subTotal) : lineTotal;
        return Math.Round(lineNet * LineTaxRate(line) / 100m, 2);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPricePermissionAsync();

        _customers = await CustomerService.GetAllAsync();
        _warehouses = await WarehouseService.GetAllAsync();
        _items = await ItemService.GetAllAsync();

        _customerId = _customers.FirstOrDefault(c => c.IsActive)?.Id ?? Guid.Empty;
        _warehouseId = _warehouses.FirstOrDefault(w => w.IsDefault)?.Id
                       ?? _warehouses.FirstOrDefault()?.Id
                       ?? Guid.Empty;

        AddLine();
    }

    // ── Requirement 3: سعر الوحدة اليدوي في فاتورة المبيعات ──
    // فاتورة المبيعات → الصلاحية الحالية المناسبة: Sales.Edit (دور الموديول «Sales»).
    // نفس قواعد الخلفية (ManualPriceRules) — ولو عُدِّل السعر من خارج الشاشة يرفضه الحارس الخلفي.
    // POS مستثنى تمامًا: هذه الشاشة ليست POS ولا تُغيّر أي شيء في POS.
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    private bool _canEditPrice;
    private const string PriceLockHint = "قراءة فقط — لا تملك صلاحية تعديل السعر يدويًا (Sales.Edit)";

    private async Task LoadPricePermissionAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            _canEditPrice = ManualPriceRules.IsAuthorized(auth.User, ManualPriceModules.Sales);
        }
        catch { _canEditPrice = false; } // فشل مغلق: أي تعذّر لقراءة الهوية ⇒ لا تعديل يدوي
    }

    private void AddLine() => _lines.Add(new LineEditor());

    private void RemoveLine(LineEditor line)
    {
        if (_lines.Count > 1) _lines.Remove(line);
    }

    private Task OnLineItemChanged(LineEditor line, Guid id)
    {
        line.ItemId = id;
        var item = _items.FirstOrDefault(i => i.Id == id);
        if (item is not null) line.UnitPrice = item.SalePrice;
        return Task.CompletedTask;
    }

    /// <summary>مسح/كتابة باركود أو كود/اسم ثم Enter → يبحث في الأصناف ويضيف/يزيد سطراً.</summary>
    private void HandleScanKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;

        var term = _scanTerm?.Trim();
        if (string.IsNullOrWhiteSpace(term)) return;

        _scanTerm = string.Empty;
        _scanFailed = false;

        // البحث الموحّد: باركود مطابق تماماً → ثم بداية الكود/الاسم (نفس منطق POS/المشتريات)
        var item = _items.FirstOrDefault(i => !string.IsNullOrEmpty(i.Barcode)
                                              && string.Equals(i.Barcode, term, StringComparison.OrdinalIgnoreCase));
        item ??= _items.FirstOrDefault(i =>
            i.Code.StartsWith(term, StringComparison.OrdinalIgnoreCase)
            || i.NameAr.StartsWith(term, StringComparison.OrdinalIgnoreCase)
            || (i.NameEn != null && i.NameEn.StartsWith(term, StringComparison.OrdinalIgnoreCase)));

        if (item is null)
        {
            _scanFailed = true;
            _lastScan = null;
            _refocusScan = true;
            return;
        }

        var line = _lines.FirstOrDefault(l => l.ItemId == item.Id);
        if (line is null)
        {
            // أزل سطر العنصر الفارغ الافتراضي (يأتي من AddLine() التمهيدي) عند أول مسح
            _lines.RemoveAll(l => l.ItemId == Guid.Empty);
            line = new LineEditor { ItemId = item.Id, Quantity = 1, UnitPrice = item.SalePrice };
            _lines.Add(line);
            _lastScan = new LastScanInfo(item.NameAr, 1, 1);
        }
        else
        {
            line.Quantity += 1;
            _lastScan = new LastScanInfo(item.NameAr, 1, line.Quantity);
        }

        _refocusScan = true;
        _scanInput?.Clear();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // إعادة التركيز إلى حقل المسح بعد كل مسح (الماسح يرسل دون أن يركز المستخدم بنفسه)
        if (_refocusScan)
        {
            _refocusScan = false;
            try { if (_scanInput is not null) await _scanInput.FocusAsync(); } catch { }
        }

        // إرفاق ممتص طفرة المسح لحقل البحث (نفس نمط POS/المشتريات) — يدفع ضغطة واحدة لكل مسح
        if (firstRender && _scanModule is null)
        {
            try
            {
                _scanModule = await Js.InvokeAsync<IJSObjectReference>("import", "./purchaseScan.js");
                await _scanModule.InvokeVoidAsync("attach");
            }
            catch { /* لا يوقف تجربة المسح لو فشل تحميل الموديول */ }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { if (_scanModule is not null) await _scanModule.DisposeAsync(); } catch { }
        _scanModule = null;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        if (_lines.Count == 0) { _error = Loc["LineRequired"]; return; }
        if (_lines.Any(l => l.ItemId == Guid.Empty)) { _error = Loc["LineItemRequired"]; return; }
        if (_lines.Any(l => l.Quantity <= 0)) { _error = Loc["QuantityPositive"]; return; }

        _error = null;
        try
        {
            await InvoiceService.CreateAsync(new CreateSalesInvoiceDto
            {
                CustomerId = _customerId,
                WarehouseId = _warehouseId,
                InvoiceDate = _invoiceDate ?? DateTime.Today,
                InvoiceType = _invoiceType,
                PaymentMethod = _paymentMethod,
                CheckNumber = _checkNumber,
                CheckBankName = _checkBankName,
                CheckBranch = _checkBranch,
                CheckIssueDate = _checkIssueDate,
                CheckDueDate = _checkDueDate,
                DiscountPercentage = _discountPercentage,
                Note = _note,
                Lines = _lines.Select(l => new CreateSalesInvoiceLineDto
                {
                    ItemId = l.ItemId,
                    Quantity = l.Quantity,
                    UnitPrice = l.UnitPrice
                }).ToList()
            });
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}

