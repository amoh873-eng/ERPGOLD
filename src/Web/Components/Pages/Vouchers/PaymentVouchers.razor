@page "/payment-vouchers"
@attribute [Authorize(Roles = "Expenses, Accounting, Admin, SuperAdmin")]
@using ERPSystem.Application.DTOs.Purchases
@using ERPSystem.Application.DTOs.Vouchers
@using ERPSystem.Application.Security
@using ERPSystem.Domain.Enums
@inject IStringLocalizer<SharedResources> Loc
@using ERPSystem.Application.Services
@inject SupplierAllocationQueries AllocationQueries
@inject ICustomerService CustomerService
@inject CustomerRefundQueries RefundQueries
@inject IPaymentVoucherReversalService ReversalService

@* صفحة سندات الصرف (المرحلة C): قائمة + فلاتر + دورة حياة (اعتماد/ترحيل/إلغاء) + طباعة + سجل تدقيق *@

<ModuleGuard ModuleKey="Expenses">
<PageTitle>@Loc["PaymentVouchers"] - @Loc["AppName"]</PageTitle>

<PageHeader Title="@Loc["PaymentVouchers"]" Icon="@Icons.Material.Filled.RequestQuote" />

<MudToolBar Class="mb-4">
    @if (_canCreate)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
            @Loc["AddPaymentVoucher"]
        </MudButton>
    }
    <MudSpacer />
    <MudTextField @bind-Value="_search" Placeholder="@Loc["SearchVoucherPlaceholder"]" Dense="true"
                  Variant="Variant.Outlined" Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search" Class="mr-2" Style="min-width:200px;" />
    <MudSelect @bind-Value="_filterSupplierId" Label="@Loc["Supplier"]" T="Guid?"
               Variant="Variant.Outlined" Clearable="true" Dense="true" Class="mr-2" Style="min-width:190px;">
        @foreach (var supplier in _suppliers)
        {
            <MudSelectItem T="Guid?" Value="@supplier.Id">@($"{supplier.Code} - {supplier.NameAr}")</MudSelectItem>
        }
    </MudSelect>
    @* SUB-2b/P3 — فلتر العميل (ردود الأموال) مع الإبقاء على فلتر المورد القائم.
       الفلترة تُنفَّذ في الخدمة (GetAsync.customerId) لا في الواجهة فقط. *@
    <MudSelect @bind-Value="_filterCustomerId" Label="@Loc["Customer"]" T="Guid?"
               Variant="Variant.Outlined" Clearable="true" Dense="true" Class="mr-2" Style="min-width:190px;">
        @foreach (var customer in _customers)
        {
            <MudSelectItem T="Guid?" Value="@customer.Id">@($"{customer.Code} - {customer.NameAr}")</MudSelectItem>
        }
    </MudSelect>
    <MudSelect @bind-Value="_filterStatus" Label="@Loc["Status"]" T="int?"
               Variant="Variant.Outlined" Clearable="true" Dense="true" Class="mr-2" Style="min-width:140px;">
        <MudSelectItem T="int?" Value="1">@Loc["VoucherStatusDraft"]</MudSelectItem>
        <MudSelectItem T="int?" Value="2">@Loc["VoucherStatusApproved"]</MudSelectItem>
        <MudSelectItem T="int?" Value="3">@Loc["VoucherStatusPosted"]</MudSelectItem>
        <MudSelectItem T="int?" Value="4">@Loc["VoucherStatusCancelled"]</MudSelectItem>
        @* SUB-2b/P3 (المرحلة الرابعة) — حالة «معكوس» (5): سند مُرحَّل أُنشئ له مستند عكس. *@
        <MudSelectItem T="int?" Value="5">@Loc["VoucherStatusReversed"]</MudSelectItem>
    </MudSelect>
    <MudDatePicker @bind-Date="_filterFrom" Label="@Loc["FromDate"]" Variant="Variant.Outlined" Clearable="true" Dense="true" Class="mr-2" />
    <MudDatePicker @bind-Date="_filterTo" Label="@Loc["ToDate"]" Variant="Variant.Outlined" Clearable="true" Dense="true" Class="mr-2" />
    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="LoadAsync" Class="mr-2">@Loc["ApplyFilter"]</MudButton>
    <MudButton Variant="Variant.Text" OnClick="ClearFilter">@Loc["ClearFilter"]</MudButton>
</MudToolBar>

@if (UnpostedCount > 0)
{
    <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">
        @string.Format(Loc["UnpostedVouchersNotice"], UnpostedCount)
    </MudAlert>
}

<MudPaper Elevation="1">
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else if (_vouchers.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="ma-2">@Loc["NoPaymentVouchers"]</MudAlert>
    }
    else
    {
        <MudTable Items="_vouchers" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>@Loc["VoucherNumber"]</MudTh>
                <MudTh>@Loc["VoucherDate"]</MudTh>
                <MudTh>@Loc["Party"]</MudTh>
                <MudTh>@Loc["BeneficiaryName"]</MudTh>
                <MudTh>@Loc["PaymentMethod"]</MudTh>
                <MudTh>@Loc["Amount"]</MudTh>
                <MudTh>@Loc["Status"]</MudTh>
                <MudTh>@Loc["VoucherJournalEntry"]</MudTh>
                <MudTh>@Loc["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.VoucherNumber</MudTd>
                <MudTd>@context.VoucherDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>
                    @context.PartyLabel
                    @if (!string.IsNullOrWhiteSpace(context.SalesReturnNumber))
                    {
                        <MudText Typo="Typo.caption" Class="muted-text">@Loc["SalesReturnRef"]: @context.SalesReturnNumber</MudText>
                    }
                </MudTd>
                <MudTd>@context.BeneficiaryName</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@(context.PaymentMethod == 1 ? Color.Info : Color.Warning)">
                        @(context.PaymentMethod == 1 ? Loc["Cash"] : Loc["Bank"])
                    </MudChip>
                </MudTd>
                <MudTd><MoneyDisplay Amount="context.Amount" /></MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@context.StatusName</MudChip>
                </MudTd>
                <MudTd>
                    @if (!string.IsNullOrEmpty(context.JournalEntryNumber))
                    {
                        <a href="/journal-entries" style="color:var(--erp-primary); text-decoration:none;">
                            <MudIcon Icon="@Icons.Material.Filled.Book" Size="Size.Small" /> @context.JournalEntryNumber
                        </a>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="muted-text">@Loc["VoucherNoJournalYet"]</MudText>
                    }
                </MudTd>
                <MudTd>
                    @if (context.Status == (int)VoucherStatus.Draft && _canEdit)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => OpenEditDialog(context))" title="@Loc["EditVoucher"]" />
                    }
                    @if (context.Status == (int)VoucherStatus.Draft && _canApprove)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Verified" Size="Size.Small" Color="Color.Info"
                                       OnClick="@(() => ApproveAsync(context))" title="@Loc["ApproveVoucher"]" />
                    }
                    @if (context.Status == (int)VoucherStatus.Approved && _canPost)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.PostAdd" Size="Size.Small" Color="Color.Success"
                                       OnClick="@(() => PostVoucherAsync(context))" title="@Loc["PostVoucher"]" />
                    }
                    @if ((context.Status == (int)VoucherStatus.Draft || context.Status == (int)VoucherStatus.Approved) && _canCancel)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => CancelVoucherAsync(context))" title="@Loc["CancelVoucher"]" />
                    }
                    @* SUB-2b/P3 (المرحلة الرابعة) — زر عكس سند **رد عميل** مُرحَّل (كامل فقط).
                       • يُعرض بسند رد عميل مُرحَّل + صلاحية العكس الخلفية فقط (وبلا أي مسار بديل للعكس).
                       • سندات الموردين لا تُعرض لها هذه الأيقونة: عكسها يحتاج اختيار صفوف التخصيص (مسار مستقل — خارج هذا النطاق).
                       • الصلاحية تُفحَص مرة أخرى داخل الخدمة، والتدقيق يُكتب في نفس المعاملة. *@
                    @if (context.Status == (int)VoucherStatus.Posted && context.CustomerId is not null && _canReverse)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small" Color="Color.Warning"
                                       Disabled="_reversing"
                                       OnClick="@(() => ReverseCustomerRefundAsync(context))"
                                       title="@Loc["ReverseCustomerRefund"]" />
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.History" Size="Size.Small"
                                   OnClick="@(() => ShowAuditAsync(context))" title="@Loc["VoucherAuditTrail"]" />
                    <MudIconButton Icon="@Icons.Material.Filled.Print" Size="Size.Small"
                                   OnClick="@(() => PrintAsync(context))" title="@Loc["Print"]" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager RowsPerPageString="@Loc["RowsPerPage"]" InfoFormat="@Loc["PagerInfo"]" />
            </PagerContent>
        </MudTable>
    }
</MudPaper>
</ModuleGuard>

@code {
    private bool _isLoading = true;
    private List<PaymentVoucherDto> _vouchers = new();
    private List<SupplierDto> _suppliers = new();
    private List<CustomerDto> _customers = new();
    private Guid? _filterSupplierId;
    private Guid? _filterCustomerId;
    private int? _filterStatus;
    private DateTime? _filterFrom;
    private DateTime? _filterTo;
    private string? _search;

    // أزرار الحالة تُبنى من نفس مصدر التصريح الخلفي (والخدمة تفحص مرة أخرى — لا حماية بالواجهة فقط)
    private bool _canCreate;
    private bool _canEdit;
    private bool _canApprove;
    private bool _canPost;
    private bool _canCancel;
    private bool _canRefund;

    /// <summary>
    /// SUB-2b/P3 (المرحلة الرابعة) — عكس سند رد عميل:
    ///  • `_canReverse`: صلاحية العكس الخلفية (نفس شرط الخدمة) — بلا أي مسار بديل في الواجهة.
    ///  • `_reversing`: تعطيل الأزرار أثناء التنفيذ ⇒ لا طلبان متزامنان من نفس الشاشة.
    ///  • `_reverseKeys`: مفتاح منع تكرار **ثابت لكل سند** يُعاد كما هو عند إعادة المحاولة
    ///    (نقر مزدوج أو انقطاع استجابة بعد نجاح المعاملة) ⇒ لا مستند عكس ثانٍ.
    /// </summary>
    private bool _canReverse;
    private bool _reversing;
    private readonly Dictionary<Guid, Guid> _reverseKeys = new();

    /// <summary>عدد السندات غير المرحّلة في القائمة المعروضة (مسودة/معتمد) — لا أثر محاسبي لها.</summary>
    private int UnpostedCount => _vouchers.Count(v =>
        v.Status == (int)VoucherStatus.Draft || v.Status == (int)VoucherStatus.Approved);

    [Inject] private IPaymentVoucherService VoucherService { get; set; } = default!;
    [Inject] private ISupplierService SupplierService { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private IVoucherAuthorization VoucherAuth { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _canCreate = VoucherAuth.CanCreate();
        _canEdit = VoucherAuth.CanEdit();
        _canApprove = VoucherAuth.CanApprove();
        _canPost = VoucherAuth.CanPost();
        _canCancel = VoucherAuth.CanCancel();
        _canRefund = VoucherAuth.CanRefund();
        _canReverse = VoucherAuth.CanReverse();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _suppliers = await SupplierService.GetAllAsync();
            _customers = await CustomerService.GetAllAsync();
            _vouchers = await VoucherService.GetAsync(
                _filterSupplierId, _filterStatus, _filterFrom, _filterTo, _search, _filterCustomerId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Loc["LoadError"]} {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ClearFilter()
    {
        _filterSupplierId = null;
        _filterCustomerId = null;
        _filterStatus = null;
        _filterFrom = null;
        _filterTo = null;
        _search = null;
        await LoadAsync();
    }

    private static Color StatusColor(int status) => status switch
    {
        (int)VoucherStatus.Draft => Color.Default,
        (int)VoucherStatus.Approved => Color.Info,
        (int)VoucherStatus.Posted => Color.Success,
        (int)VoucherStatus.Cancelled => Color.Error,
        // SUB-2b/P3 — «معكوس» حالة مستقلة (5) لا تُخلط بالملغى (4): الأصل يبقى محفوظًا مع مستند عكس.
        (int)VoucherStatus.Reversed => Color.Warning,
        _ => Color.Default
    };

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            ["VoucherService"] = VoucherService,
                ["AllocationQueries"] = AllocationQueries,
            ["Suppliers"] = _suppliers,
            ["Customers"] = _customers,
            ["RefundQueries"] = RefundQueries,
            ["CanRefund"] = _canRefund,
            ["CanApproveAndPost"] = _canApprove && _canPost
        };
        var dialog = await DialogService.ShowAsync<PaymentVoucherFormDialog>(
            Loc["AddPaymentVoucher"], parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true)
        {
            NotifyResult(result?.Data as string);
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(PaymentVoucherDto voucher)
    {
        var parameters = new DialogParameters
        {
            ["VoucherService"] = VoucherService,
                ["AllocationQueries"] = AllocationQueries,
            ["Suppliers"] = _suppliers,
            ["Customers"] = _customers,
            ["RefundQueries"] = RefundQueries,
            ["CanRefund"] = _canRefund,
            ["Existing"] = voucher,
            ["CanApproveAndPost"] = _canApprove && _canPost
        };
        var dialog = await DialogService.ShowAsync<PaymentVoucherFormDialog>(
            Loc["EditVoucher"], parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true)
        {
            NotifyResult(result?.Data as string);
            await LoadAsync();
        }
    }

    /// <summary>رسالة نتيجة الحوار: «حفظ وترحيل» تنجح برقم القيد، والحفظ كمسودة تُنبَّه بغياب الأثر المحاسبي.</summary>
    private void NotifyResult(string? outcome)
    {
        if (outcome is not null && outcome.StartsWith("posted", StringComparison.Ordinal))
        {
            var entry = outcome.Length > "posted:".Length ? outcome["posted:".Length..] : string.Empty;
            Snackbar.Add(string.Format(Loc["VoucherPostedSuccess"], entry), Severity.Success);
            return;
        }

        Snackbar.Add(Loc["VoucherDraftSavedNoEffect"], Severity.Info);
    }

    private async Task ApproveAsync(PaymentVoucherDto voucher)
    {
        try
        {
            await VoucherService.ApproveAsync(voucher.Id);
            Snackbar.Add(Loc["VoucherApprovedMsg"], Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task PostVoucherAsync(PaymentVoucherDto voucher)
    {
        var confirmed = await DialogService.ShowMessageBox(
            Loc["PostVoucher"], Loc["ConfirmPostVoucherMsg"], yesText: Loc["Confirm"], cancelText: Loc["Cancel"]);
        if (confirmed != true) return;

        try
        {
            await VoucherService.PostAsync(voucher.Id);
            Snackbar.Add(Loc["VoucherPostedMsg"], Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task CancelVoucherAsync(PaymentVoucherDto voucher)
    {
        var confirmed = await DialogService.ShowMessageBox(
            Loc["CancelVoucher"], Loc["ConfirmCancelVoucherMsg"], yesText: Loc["Confirm"], cancelText: Loc["Cancel"]);
        if (confirmed != true) return;

        try
        {
            await VoucherService.CancelAsync(voucher.Id, Loc["CancelVoucher"]);
            Snackbar.Add(Loc["VoucherCancelledMsg"], Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>
    /// SUB-2b/P3 (المرحلة الرابعة) — عكس سند رد عميل مُرحَّل **من الواجهة** (كامل فقط؛ لا عكس جزئي).
    ///
    /// القواعد المُطبَّقة (ولا يُغيَّر أي منها هنا):
    ///  • الصلاحية: الزر لا يُعرض إلا بـ`CanReverse()` الخلفية، والخدمة تفحصها مرة أخرى ⇒ لا حماية واجهية فقط.
    ///  • منع التكرار: مفتاح ثابت لكل سند + تعطيل الزر أثناء التنفيذ ⇒ النقر المزدوج لا يُنشئ مستند عكس ثانٍ،
    ///    وإعادة المحاولة بعد انقطاع الاستجابة تُعيد المستند نفسه (idempotency في الخدمة).
    ///  • لا كسر للسقف: الخدمة تعيد الرصيد دائنًا مرة واحدة وتُحرِّر المتبقي القابل للرد، وتعيد السند إلى `Reversed`.
    ///  • التدقيق: الخدمة تكتب سطري تدقيق (`PaymentVoucherReversal` + `Reversed`) في نفس معاملة العكس.
    /// </summary>
    private async Task ReverseCustomerRefundAsync(PaymentVoucherDto voucher)
    {
        if (_reversing) return;

        var confirmed = await DialogService.ShowMessageBox(
            Loc["ReverseCustomerRefund"],
            string.Format(Loc["ConfirmReverseCustomerRefundMsg"], voucher.VoucherNumber, voucher.Amount.ToString("0.00")),
            yesText: Loc["Confirm"], cancelText: Loc["Cancel"]);
        if (confirmed != true) return;

        _reversing = true;
        if (!_reverseKeys.TryGetValue(voucher.Id, out var idempotencyKey))
        {
            idempotencyKey = Guid.NewGuid();
            _reverseKeys[voucher.Id] = idempotencyKey;
        }

        try
        {
            var reversal = await ReversalService.ReverseAsync(new CreatePaymentVoucherReversalDto
            {
                OriginalPaymentVoucherId = voucher.Id,
                VoucherDate = DateTime.Today,
                Reason = Loc["ReverseCustomerRefundReason"],
                IdempotencyKey = idempotencyKey
            });

            _reverseKeys.Remove(voucher.Id);
            Snackbar.Add(string.Format(Loc["CustomerRefundReversedMsg"], reversal.ReversalNumber), Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _reversing = false;
        }
    }

    private async Task ShowAuditAsync(PaymentVoucherDto voucher)
    {
        try
        {
            var audit = await VoucherService.GetAuditAsync(voucher.Id);
            var parameters = new DialogParameters { ["Entries"] = audit };
            await DialogService.ShowAsync<VoucherAuditDialog>(
                $"{Loc["VoucherAuditTrail"]} — {voucher.VoucherNumber}", parameters,
                new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task PrintAsync(PaymentVoucherDto voucher)
    {
        var fields = new List<KeyValuePair<string, string>>
        {
            new(Loc["VoucherNumber"], voucher.VoucherNumber),
            new(Loc["VoucherDate"], voucher.VoucherDate.ToString("yyyy-MM-dd")),
            new(Loc["Party"], voucher.PartyLabel),
            new(Loc["SalesReturnRef"], voucher.SalesReturnNumber ?? "-"),
            new(Loc["BeneficiaryName"], voucher.BeneficiaryName ?? "-"),
            new(Loc["PaymentMethod"], voucher.PaymentMethod == 1 ? Loc["Cash"] : Loc["Bank"]),
            new(Loc["Amount"], voucher.Amount.ToString("0.00")),
            new(Loc["CashOrBankAccount"], voucher.CashOrBankAccountLabel),
            // سند رد العميل: الحساب المقابل هو 1200 (ذمم العملاء) وليس 2200 (ذمم الموردين)
            // ⇒ وسم محايد «الحساب المقابل للطرف» بدل تسمية الموردين المضلِّلة (R9 — عرض فقط).
            new(voucher.CustomerId is not null ? Loc["CounterpartAccount"] : Loc["PayableAccount"], voucher.PayableAccountLabel),
            new(Loc["Status"], voucher.StatusName),
            new(Loc["Description"], voucher.Description ?? "-"),
            new(Loc["ExternalReference"], voucher.ExternalReference ?? "-"),
            new(Loc["VoucherJournalEntry"], string.IsNullOrEmpty(voucher.JournalEntryNumber) ? "-" : voucher.JournalEntryNumber!)
        };

        var parameters = new DialogParameters
        {
            ["Title"] = $"{Loc["PaymentVoucher"]} — {voucher.VoucherNumber}",
            ["Fields"] = fields,
            // طباعة السند: Note معامل نصي في VoucherPrintDialog ⇒ يجب تمرير .Value
            // (تمرير LocalizedString مباشرة يرمي InvalidCastException ويُسقط الحوار — اكتُشف بفحص واجهي فعلي).
            ["Note"] = string.IsNullOrEmpty(voucher.JournalEntryNumber) ? Loc["VoucherNoJournalYet"].Value : Loc["VoucherHasJournalEntry"].Value
        };

        await DialogService.ShowAsync<VoucherPrintDialog>(Loc["Print"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
    }
}
