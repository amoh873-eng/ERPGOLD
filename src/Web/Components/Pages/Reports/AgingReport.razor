@page "/reports/ar-aging"
@page "/reports/ap-aging"
@attribute [Authorize(Roles = "Reports")]
@using ERPSystem.Application.DTOs.Reports
@using ERPSystem.Application.Interfaces
@using Microsoft.Extensions.Localization
<ModuleGuard ModuleKey="Reports">
@inject IReportService ReportService
@inject IStringLocalizer<SharedResources> Loc
@inject ISnackbar Snackbar
@inject ISystemSettingsService Settings
@inject IDialogService Dialogs
@inject NavigationManager Nav

<PageTitle>@(Title) - @Loc["AppName"]</PageTitle>
<PageHeader Title="@Title" Icon="@Icons.Material.Filled.FactCheck" />

<MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E5E7EB">
    <MudGrid AlignItems="AlignItems.End" Spacing="3">
        <MudItem xs="12" sm="4">
            <MudDatePicker @bind-Date="_asOf" Label="@Loc["AsOfDate"]" Variant="Variant.Outlined" T="DateTime?" AutoClose="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync" Disabled="_loading" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Search">@Loc["GenerateReport"]</MudButton>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="OpenExportPopup" Disabled="_report is null" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.PictureAsPdf">@Loc["View"] / @Loc["Print"]</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudPaper Elevation="0" Class="pa-8 d-flex justify-center"><MudProgressCircular Indeterminate="true" Size="Size.Large" /></MudPaper>
}
else if (_report is null)
{
    <MudPaper Elevation="0" Class="pa-6"><MudText Align="Align.Center" Style="color:#6B7280">@Loc["SelectDateRange"]</MudText></MudPaper>
}
else if (_report.Rows.Count == 0)
{
    <MudPaper Elevation="0" Class="pa-6"><MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@Loc["NoOpenInvoices"]</MudAlert></MudPaper>
}
else
{
    <MudPaper Elevation="1" Class="overflow-x-auto">
        <MudTable Items="_report.Rows" Hover="true" Dense="true" Striped="true">
            <HeaderContent>
                <MudTh>@Loc["PartyName"]</MudTh>
                <MudTh Class="justify-end">@Loc["Bucket0_30"]</MudTh>
                <MudTh Class="justify-end">@Loc["Bucket31_60"]</MudTh>
                <MudTh Class="justify-end">@Loc["Bucket61_90"]</MudTh>
                <MudTh Class="justify-end">@Loc["Bucket90Plus"]</MudTh>
                <MudTh Class="justify-end">@Loc["BucketTotal"]</MudTh>
                @if (IsReceivable)
                {
                    <MudTh Class="justify-end">@Loc["CreditBeforeRefunds"]</MudTh>
                    <MudTh Class="justify-end">@Loc["RefundsPaid"]</MudTh>
                    <MudTh Class="justify-end">@Loc["RemainingRefundableCredit"]</MudTh>
                }
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><b>@context.PartyCode</b> — @context.PartyNameAr</MudTd>
                <MudTd><MoneyDisplay Amount="context.Bucket0_30" /></MudTd>
                <MudTd><MoneyDisplay Amount="context.Bucket31_60" /></MudTd>
                <MudTd><MoneyDisplay Amount="context.Bucket61_90" /></MudTd>
                <MudTd><MoneyDisplay Amount="context.Bucket90Plus" /></MudTd>
                <MudTd><b><MoneyDisplay Amount="context.Total" /></b></MudTd>
                @if (IsReceivable)
                {
                    <MudTd><MoneyDisplay Amount="context.CreditBeforeRefunds" /></MudTd>
                    <MudTd><MoneyDisplay Amount="context.RefundsPaid" /></MudTd>
                    <MudTd><b><MoneyDisplay Amount="context.RemainingRefundableCredit" /></b></MudTd>
                }
                <MudTd><MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" OnClick="() => OpenDrillDown(context)">@Loc["DrillDown"]</MudButton></MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd><b>@Loc["BucketTotal"]</b></MudTd>
                <MudTd><b><MoneyDisplay Amount="_report.Total0_30" /></b></MudTd>
                <MudTd><b><MoneyDisplay Amount="_report.Total31_60" /></b></MudTd>
                <MudTd><b><MoneyDisplay Amount="_report.Total61_90" /></b></MudTd>
                <MudTd><b><MoneyDisplay Amount="_report.Total90Plus" /></b></MudTd>
                <MudTd><b><MoneyDisplay Amount="_report.TotalAll" /></b></MudTd>
                @if (IsReceivable)
                {
                    <MudTd><b><MoneyDisplay Amount="_report.TotalCreditBeforeRefunds" /></b></MudTd>
                    <MudTd><b><MoneyDisplay Amount="_report.TotalRefundsPaid" /></b></MudTd>
                    <MudTd><b><MoneyDisplay Amount="_report.TotalRefundableCredit" /></b></MudTd>
                }
                <MudTd></MudTd>
            </FooterContent>
        </MudTable>
    </MudPaper>

    @if (_topCustomers.Count > 0)
    {
        <MudPaper Elevation="1" Class="mt-3 pa-4" Style="border-top:2px solid #F59E0B">
            <MudText Typo="@Typo.h6" Class="mb-2">@Loc["ConcentrationRisk"] — @Loc["Top5Customers"]</MudText>
            <MudTable Items="_topCustomers" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>@Loc["AgingCustomer"]</MudTh>
                    <MudTh Class="justify-end">@Loc["GrossSales"]</MudTh>
                    <MudTh Class="justify-end">@Loc["PercentOfSales"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Name</MudTd>
                    <MudTd><MoneyDisplay Amount="context.Amount" /></MudTd>
                    <MudTd><MudText Style="@_warnStyle">@context.Percent.ToString("0.0")%</MudText></MudTd>
                </RowTemplate>
            </MudTable>
            @if (_concentrationWarning)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3">@Loc["ConcentrationWarning"]</MudAlert>
            }
        </MudPaper>
    }
}

    @* ═══ P0-2H (المرحلة A): بند مستقل — المقبوضات بلا تخصيص موثق ═══
       لا يُخصم من أرصدة الفواتير أعلاه، ويُعرض للعملاء (AR) فقط لأن كيان التخصيص غائب عن العملاء. *@
    @if (_report is not null && _report.IsReceivable
         && (_report.UnallocatedReceiptsTotal != 0m || _report.UnallocatedChecksTotal != 0m || _report.InvoiceLinkedChecksTotal != 0m))
    {
        <MudPaper Elevation="1" Class="mt-3 pa-4" Style="border-top:2px solid #0EA5E9">
            <MudText Typo="@Typo.h6" Class="mb-2">@Loc["UnallocatedReceiptsTitle"]</MudText>
            <MudSimpleTable Dense="true" Elevation="0" Class="mb-0">
                <thead>
                    <tr>
                        <th>@Loc["UnallocatedReceiptsTitle"]</th>
                        <th class="justify-end">@Loc["BucketTotal"]</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Loc["UnallocatedReceiptVouchers"]</td>
                        <td class="justify-end"><MoneyDisplay Amount="_report.UnallocatedReceiptsTotal" /></td>
                    </tr>
                    <tr>
                        <td>@Loc["UnallocatedChecksNoInvoiceLink"]</td>
                        <td class="justify-end"><MoneyDisplay Amount="_report.UnallocatedChecksTotal" /></td>
                    </tr>
                    <tr>
                        <td><b>@Loc["UnallocatedTotal"]</b></td>
                        <td class="justify-end"><b><MoneyDisplay Amount="@(_report.UnallocatedReceiptsTotal + _report.UnallocatedChecksTotal)" /></b></td>
                    </tr>
                    <tr>
                        <td>@Loc["ChecksLinkedToInvoiceNotDeducted"]</td>
                        <td class="justify-end"><MoneyDisplay Amount="_report.InvoiceLinkedChecksTotal" /></td>
                    </tr>
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }

    @* ═══ SUB-2b/P3 — المرحلة الثالثة (D‑A / D‑D): الرصيد الدائن ومصادره والردود والتعارضات ═══
       عرض فقط: لا يُخصم أي مبلغ من فاتورة، ولا يُنشأ تخصيص، ولا تتغيّر الفئات العمرية المدينة.
       «غير المخصص» يبقى بندًا مستقلًا، ويُستهلك منه فقط ما موّل ردودًا تجاوزت رصيد الفواتير الدائن. *@
    @if (_report is not null && _report.IsReceivable
         && (_report.TotalCreditBeforeRefunds != 0m || _report.TotalRefundsPaid != 0m
             || _report.TotalUnallocatedCredit != 0m || _report.HasCreditConflicts))
    {
        <MudPaper Elevation="1" Class="mt-3 pa-4" Style="border-top:2px solid #6D5BD0">
            <MudText Typo="@Typo.h6" Class="mb-2">@Loc["RefundsTitle"]</MudText>
            <MudSimpleTable Dense="true" Elevation="0" Class="mb-2">
                <thead>
                    <tr>
                        <th>@Loc["CreditSourceItem"]</th>
                        <th class="justify-end">@Loc["BucketTotal"]</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Loc["TotalDueOnCustomer"]</td>
                        <td class="justify-end"><MoneyDisplay Amount="_report.TotalAll" /></td>
                    </tr>
                    <tr>
                        <td>@Loc["CreditBeforeRefunds"]</td>
                        <td class="justify-end"><MoneyDisplay Amount="_report.TotalCreditBeforeRefunds" /></td>
                    </tr>
                    <tr>
                        <td>@Loc["RefundsAppliedToInvoices"]</td>
                        <td class="justify-end"><MoneyDisplay Amount="_report.TotalRefundsAppliedToInvoiceCredit" /></td>
                    </tr>
                    <tr>
                        <td>@Loc["RefundsPaid"]</td>
                        <td class="justify-end"><MoneyDisplay Amount="_report.TotalRefundsPaid" /></td>
                    </tr>
                    <tr>
                        <td><b>@Loc["RemainingRefundableCredit"]</b></td>
                        <td class="justify-end"><b><MoneyDisplay Amount="_report.TotalRefundableCredit" /></b></td>
                    </tr>
                    <tr>
                        <td>@Loc["UnallocatedCreditTotal"]</td>
                        <td class="justify-end"><MoneyDisplay Amount="_report.TotalUnallocatedCredit" /></td>
                    </tr>
                    <tr>
                        <td>@Loc["UnallocatedCreditConsumedByRefunds"]</td>
                        <td class="justify-end"><MoneyDisplay Amount="_report.TotalUnallocatedCreditConsumedByRefunds" /></td>
                    </tr>
                    <tr>
                        <td><b>@Loc["UnallocatedCreditRemaining"]</b></td>
                        <td class="justify-end"><b><MoneyDisplay Amount="_report.TotalUnallocatedCreditRemaining" /></b></td>
                    </tr>
                    <tr>
                        <td>@Loc["CreditPoolRemaining"]</td>
                        <td class="justify-end"><MoneyDisplay Amount="@(_report.TotalRefundableCredit + _report.TotalUnallocatedCreditRemaining)" /></td>
                    </tr>
                    <tr>
                        <td>@Loc["NetDocumentedPosition"]</td>
                        <td class="justify-end"><MoneyDisplay Amount="@(_report.TotalAll + _report.TotalCredit - _report.TotalUnallocatedCreditRemaining)" /></td>
                    </tr>
                    @if (_report.TotalRefundsBeyondInvoiceCredit != 0m)
                    {
                        <tr>
                            <td>@Loc["RefundsBeyondInvoiceCredit"]</td>
                            <td class="justify-end"><MoneyDisplay Amount="_report.TotalRefundsBeyondInvoiceCredit" /></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>

            @if (_report.TotalRefundsWithNoDocumentedCredit != 0m || _report.TotalRefundsBeyondReturnCap != 0m)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-2 mb-2">
                    @Loc["CreditConflictsTitle"]
                </MudAlert>
                <MudSimpleTable Dense="true" Elevation="0" Class="mb-2">
                    <thead>
                        <tr>
                            <th>@Loc["CreditConflictItem"]</th>
                            <th class="justify-end">@Loc["BucketTotal"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_report.TotalRefundsWithNoDocumentedCredit != 0m)
                        {
                            <tr>
                                <td>@Loc["RefundsWithNoDocumentedCredit"]</td>
                                <td class="justify-end"><MoneyDisplay Amount="_report.TotalRefundsWithNoDocumentedCredit" /></td>
                            </tr>
                        }
                        @if (_report.TotalRefundsBeyondReturnCap != 0m)
                        {
                            <tr>
                                <td>@Loc["RefundsBeyondReturnCap"]</td>
                                <td class="justify-end"><MoneyDisplay Amount="_report.TotalRefundsBeyondReturnCap" /></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }

            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">@Loc["ComputedResidualBanner"]</MudAlert>
            @if (!string.IsNullOrWhiteSpace(_report.ComputedResidualNote))
            {
                <MudText Typo="@Typo.caption" Class="mt-2" Style="color:#6B7280">@_report.ComputedResidualNote</MudText>
            }
        </MudPaper>
    }
</ModuleGuard>
@code {
    private DateTime? _asOf = DateTime.Today;
    private bool _loading;
    private AgingReportDto? _report;
    private List<ERPSystem.Application.Services.AgingReportQueries.TopCustomerRow> _topCustomers = new();
    private bool _concentrationWarning;
    private string _brand = "ERP";
    private string _warnStyle => "color:#EF4444;font-weight:800";

    private string Title => IsReceivable ? Loc["ArAging"].Value : Loc["ApAging"].Value;
    private bool IsReceivable => Nav.Uri.Contains("/reports/ar-aging", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        try { var s = await Settings.GetAsync(); _brand = s.AppDisplayName ?? "ERP"; } catch { }
    }

    private async Task LoadAsync()
    {
        if (!_asOf.HasValue) { Snackbar.Add("يرجى تحديد التاريخ", Severity.Warning); return; }
        _loading = true;
        try
        {
            _report = await ReportService.GetAgingReportAsync(IsReceivable, _asOf.Value.Date);
            _topCustomers = new(); _concentrationWarning = false;
            if (IsReceivable)
            {
                var (top, warn) = await ReportService.GetTopCustomersAsync(_asOf.Value.Date);
                _topCustomers = top; _concentrationWarning = warn;
            }
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); _report = null; }
        finally { _loading = false; }
    }

    private async Task OpenDrillDown(AgingPartyRow party)
    {
        var headers = new List<string> { Loc["InvoiceNumber"].Value, Loc["AgingInvoiceDate"].Value, Loc["AgingDueDate"].Value, Loc["AgingDaysOverdue"].Value, Loc["RefundsApplied"].Value, Loc["AgingBalance"].Value };
        var rows = new List<List<string>>();

        // D‑A / D‑D: تفكيك **مستوى الطرف** أولًا (مصادر الرصيد الدائن والردود والتعارضات) —
        // يظهر مرة واحدة لكل عميل ولا يتكرر في كل سطر فاتورة.
        void AddSummary(string label, decimal value) => rows.Add(new List<string>
        {
            label, "", "", "", "", value.ToString("N2")
        });

        AddSummary(Loc["TotalDueOnCustomer"].Value, party.Total);
        AddSummary(Loc["CreditBeforeRefunds"].Value, party.CreditBeforeRefunds);
        AddSummary(Loc["RefundsAppliedToInvoices"].Value, party.RefundsAppliedToInvoiceCredit);
        AddSummary(Loc["RefundsPaid"].Value, party.RefundsPaid);
        AddSummary(Loc["RemainingRefundableCredit"].Value, party.RemainingRefundableCredit);
        if (party.UnallocatedCreditTotal != 0m)
            AddSummary(Loc["UnallocatedCreditTotal"].Value, party.UnallocatedCreditTotal);
        if (party.UnallocatedCreditConsumedByRefunds != 0m)
            AddSummary(Loc["UnallocatedCreditConsumedByRefunds"].Value, party.UnallocatedCreditConsumedByRefunds);
        AddSummary(Loc["UnallocatedCreditRemaining"].Value, party.UnallocatedCreditRemaining);
        AddSummary(Loc["CreditPoolRemaining"].Value, party.CreditPoolRemaining);
        AddSummary(Loc["NetDocumentedPosition"].Value, party.NetDocumentedPosition);
        if (party.RefundsWithNoDocumentedCredit != 0m)
            AddSummary("! " + Loc["RefundsWithNoDocumentedCredit"].Value, party.RefundsWithNoDocumentedCredit);
        if (party.RefundsBeyondReturnCap != 0m)
            AddSummary("! " + Loc["RefundsBeyondReturnCap"].Value, party.RefundsBeyondReturnCap);

        rows.Add(new List<string> { "— " + Loc["OpenInvoices"].Value + " —", "", "", "", "", "" });

        foreach (var i in party.Invoices)
        {
            rows.Add(new List<string>
            {
                (i.IsCreditLine ? Loc["CreditLineMarker"].Value + ": " : "") + i.InvoiceNumber,
                i.InvoiceDate.ToString("yyyy-MM-dd"),
                i.DueDate.ToString("yyyy-MM-dd"),
                i.DaysOverdue.ToString(),
                i.RefundsApplied.ToString("N2"),
                i.Balance.ToString("N2")
            });
        }

        var totals = new List<string> { "", "", "", Loc["BucketTotal"].Value, party.RefundsPaid.ToString("N2"), party.Total.ToString("N2") };
        var table = new GenericReportTable
        {
            TitleAr = $"{party.PartyNameAr} — {Loc["OpenInvoices"].Value}",
            Headers = headers, Rows = rows, Totals = totals,
            ParamSummary = $"{Loc["AsOfDate"].Value}: {(_asOf ?? DateTime.Today):yyyy-MM-dd}",
            FooterNote = party.HasCreditConflict ? Loc["CreditConflictsTitle"].Value : null,
            Landscape = true
        };
        await Dialogs.ShowAsync<ReportPopup>(table.TitleAr, new DialogParameters { ["Table"] = table, ["Brand"] = _brand }, new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true });
    }

    private async Task OpenExportPopup()
    {
        if (_report is null) return;
        var headers = new List<string> { Loc["PartyName"].Value, Loc["Bucket0_30"].Value, Loc["Bucket31_60"].Value, Loc["Bucket61_90"].Value, Loc["Bucket90Plus"].Value, Loc["BucketTotal"].Value };
        var rows = _report.Rows.Select(r => new List<string>
        {
            r.PartyCode + " — " + r.PartyNameAr, r.Bucket0_30.ToString("N2"), r.Bucket31_60.ToString("N2"), r.Bucket61_90.ToString("N2"), r.Bucket90Plus.ToString("N2"), r.Total.ToString("N2")
        }).ToList();

        // P0-2H (المرحلة A): بند مستقل في الطبع/التصدير — أرقامه **لا تدخل** مجموع الفواتير أدناه.
        if (_report.IsReceivable)
        {
            if (_report.UnallocatedReceiptsTotal != 0m)
                rows.Add(new List<string> { "• " + Loc["UnallocatedReceiptVouchers"].Value, "", "", "", "", _report.UnallocatedReceiptsTotal.ToString("N2") });
            if (_report.UnallocatedChecksTotal != 0m)
                rows.Add(new List<string> { "• " + Loc["UnallocatedChecksNoInvoiceLink"].Value, "", "", "", "", _report.UnallocatedChecksTotal.ToString("N2") });
            if (_report.InvoiceLinkedChecksTotal != 0m)
                rows.Add(new List<string> { "• " + Loc["ChecksLinkedToInvoiceNotDeducted"].Value, "", "", "", "", _report.InvoiceLinkedChecksTotal.ToString("N2") });

            // D‑A / D‑D: المتبقي غير المخصص بعد الردود المموّلة منه + التعارضات (بنود مستقلة).
            if (_report.TotalUnallocatedCreditRemaining != 0m)
                rows.Add(new List<string> { "• " + Loc["UnallocatedCreditRemaining"].Value, "", "", "", "", _report.TotalUnallocatedCreditRemaining.ToString("N2") });
            if (_report.TotalRefundsWithNoDocumentedCredit != 0m)
                rows.Add(new List<string> { "! " + Loc["RefundsWithNoDocumentedCredit"].Value, "", "", "", "", _report.TotalRefundsWithNoDocumentedCredit.ToString("N2") });
            if (_report.TotalRefundsBeyondReturnCap != 0m)
                rows.Add(new List<string> { "! " + Loc["RefundsBeyondReturnCap"].Value, "", "", "", "", _report.TotalRefundsBeyondReturnCap.ToString("N2") });
        }

        var totals = new List<string> { Loc["BucketTotal"].Value, _report.Total0_30.ToString("N2"), _report.Total31_60.ToString("N2"), _report.Total61_90.ToString("N2"), _report.Total90Plus.ToString("N2"), _report.TotalAll.ToString("N2") };
        var table = new GenericReportTable
        {
            TitleAr = Title, Headers = headers, Rows = rows, Totals = totals,
            ParamSummary = IsReceivable
                ? $"{Loc["AsOfDate"].Value}: {(_asOf ?? DateTime.Today):yyyy-MM-dd} | {Loc["ComputedResidualBanner"].Value}"
                : $"{Loc["AsOfDate"].Value}: {(_asOf ?? DateTime.Today):yyyy-MM-dd}",
            Landscape = true
        };
        await Dialogs.ShowAsync<ReportPopup>(Title, new DialogParameters { ["Table"] = table, ["Brand"] = _brand }, new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true });
    }
}