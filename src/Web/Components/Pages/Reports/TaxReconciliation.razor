@page "/reports/tax-reconciliation"
@attribute [Authorize(Roles = "Reports")]
@using ERPSystem.Application.DTOs.Reports
<ModuleGuard ModuleKey="Reports">
@inject IReportService ReportService
@inject IStringLocalizer<SharedResources> Loc
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject ISystemSettingsService Settings

<PageTitle>@Loc["TaxReconciliation"] - @Loc["AppName"]</PageTitle>
<PageHeader Title="@Loc["TaxReconciliation"]" Icon="@Icons.Material.Filled.Balance" />

@* ── قسم الفلاتر: نطاق التاريخ + زر التوليد ── *@
<MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E5E7EB">
    <MudText Typo="@Typo.subtitle2" Class="mb-2">@Loc["TaxReconciliationSubtitle"]</MudText>
    <MudGrid AlignItems="AlignItems.End" Spacing="3">
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="_from" Label="@Loc["FromDate"]" Variant="Variant.Outlined" T="DateTime?" AutoClose="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="_to" Label="@Loc["ToDate"]" Variant="Variant.Outlined" T="DateTime?" AutoClose="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GenerateAsync"
                       Disabled="_loading" FullWidth="true" StartIcon="@Icons.Material.Filled.Search">
                @Loc["GenerateReport"]
            </MudButton>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="OpenExportPopup"
                       Disabled="_report is null" FullWidth="true" StartIcon="@Icons.Material.Filled.PictureAsPdf">
                @Loc["View"] / @Loc["Print"]
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudPaper Elevation="0" Class="pa-8 d-flex justify-center">
        <MudProgressCircular Indeterminate="true" Size="Size.Large" />
    </MudPaper>
}
else if (_report is null)
{
    <MudPaper Elevation="0" Class="pa-6">
        <MudText Align="Align.Center" Style="color:#6B7280">@Loc["SelectDateRange"]</MudText>
    </MudPaper>
}
else
{
    <MudGrid Spacing="3">
        @* بطاقة المخرجات (ضريبة المبيعات) *@
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid #E5E7EB;border-top:4px solid #3B82F6;border-radius:10px;">
                <MudText Typo="@Typo.caption" Style="color:#6B7280">@Loc["SalesTaxOutput"]</MudText>
                <MudText Typo="@Typo.h5" Style="font-weight:700;color:#3B82F6"><MoneyDisplay Amount="_report.SalesTaxOutput" /></MudText>
                <MudText Typo="@Typo.caption">@Loc["GrossSales"]: <MoneyDisplay Amount="_report.TotalSalesGross" /></MudText>
            </MudPaper>
        </MudItem>
        @* بطاقة ضريبة المشتريات المسجّلة *@
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid #E5E7EB;border-top:4px solid #10B981;border-radius:10px;">
                <MudText Typo="@Typo.caption" Style="color:#6B7280">@Loc["RecordedPurchaseTax"]</MudText>
                <MudText Typo="@Typo.h5" Style="font-weight:700;color:#10B981"><MoneyDisplay Amount="_report.RecordedPurchaseTax" /></MudText>
                <MudText Typo="@Typo.caption">@Loc["GrossPurchases"]: <MoneyDisplay Amount="_report.TotalPurchasesGross" /></MudText>
            </MudPaper>
        </MudItem>
        @* بطاقة صافي ضريبة المبيعات قبل تسوية ضريبة المدخلات القابلة للخصم *@
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid #E5E7EB;border-top:4px solid #F59E0B;border-radius:10px;">
                <MudText Typo="@Typo.caption" Style="color:#6B7280">@Loc["NetSalesTaxBeforeVat"]</MudText>
                <MudText Typo="@Typo.h5" Style="font-weight:700;color:#F59E0B"><MoneyDisplay Amount="_report.NetSalesTaxBeforeVat" /></MudText>
            </MudPaper>
        </MudItem>
        @* بطاقة حالة التسوية (غير نهائية حتى تُعرف ضريبة المدخلات القابلة للخصم) *@
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="pa-4" Style="@($"border:1px solid #E5E7EB;border-top:4px solid {_borderColor};border-radius:10px;")">
                <MudText Typo="@Typo.caption" Style="color:#6B7280">@Loc["TaxStatus"]</MudText>
                <MudText Typo="@Typo.h6" Style="@($"font-weight:700;color:{_statusColor}")">
                    @Loc["TaxNotFinal"]
                </MudText>
                <MudText Typo="@Typo.caption">@Loc["TaxNotFinalHint"]</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ── تفصيل التسوية حسب نسبة الضريبة (Sales Output / Recorded Purchase) ── *@
    <MudPaper Elevation="1" Class="mt-4">
        <MudText Typo="@Typo.subtitle2" Class="pa-3 pb-0">@Loc["TaxBreakdownByRate"]</MudText>
        <MudTable Items="_report.Breakdown" Hover="true" Dense="true" Striped="true">
            <HeaderContent>
                <MudTh>@Loc["TaxDescription"]</MudTh>
                <MudTh>@Loc["TaxRate"]</MudTh>
                <MudTh Class="justify-end">@Loc["SalesTaxOutput"]</MudTh>
                <MudTh Class="justify-end">@Loc["RecordedPurchaseTax"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.TaxDescription</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@context.TaxRate.ToString("0.#")%</MudChip></MudTd>
                <MudTd><MoneyDisplay Amount="context.SalesOutputTax" /></MudTd>
                <MudTd><MoneyDisplay Amount="context.RecordedPurchaseTax" /></MudTd>
            </RowTemplate>
        </MudTable>
        <MudPaper Elevation="0" Class="pa-3" Style="border-top:2px solid #E5E7EB;background:#F9FAFB;">
            <MudText Typo="@Typo.body2">@Loc["Total"]: @Loc["SalesTaxOutput"] <MoneyDisplay Amount="_report.TotalBreakdownSalesTax" /> — @Loc["RecordedPurchaseTax"] <MoneyDisplay Amount="_report.TotalBreakdownPurchaseTax" /></MudText>
        </MudPaper>
    </MudPaper>
}
</ModuleGuard>
@code {
    private DateTime? _from = new DateTime(DateTime.Today.AddMonths(-1).Year, DateTime.Today.AddMonths(-1).Month, 1);
    private DateTime? _to = DateTime.Today;
    private bool _loading;
    private TaxReconciliationDto? _report;
    private string _brand = "ERP";

    /// <summary>لون إطار بطاقة الحالة — رمادي/محايد لأن التسوية غير نهائية (ضريبة المدخلات غير معروفة).</summary>
    private string _borderColor => "#6B7280";

    /// <summary>لون نص الحالة.</summary>
    private string _statusColor => "#6B7280";

    protected override async Task OnInitializedAsync()
    {
        try { var s = await Settings.GetAsync(); _brand = s.AppDisplayName ?? "ERP"; } catch { }
    }

    /// <summary>توليد التسوية حسب نطاق التاريخ المحدد (مع تحقق من صحة النطاق).</summary>
    private async Task GenerateAsync()
    {
        if (!_from.HasValue || !_to.HasValue)
        {
            Snackbar.Add(Loc["DateRangeRequired"], Severity.Warning);
            return;
        }
        if (_from.Value.Date > _to.Value.Date)
        {
            Snackbar.Add(Loc["InvalidDateRange"], Severity.Warning);
            return;
        }

        _loading = true;
        try
        {
            _report = await ReportService.GetTaxReconciliationAsync(_from.Value.Date, _to.Value.Date);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _report = null;
        }
        finally { _loading = false; }
    }

    /// <summary>بناء GenericReportTable لفتح نافذة العرض/الطباعة/التصدير (Excel/PDF عبر ReportPopup).</summary>
    private GenericReportTable BuildGenericTable()
    {
        var headers = new List<string> { "وصف الضريبة", "النسبة", "ضريبة المبيعات (مخرجات)", "ضريبة المشتريات المسجّلة" };
        var rows = _report!.Breakdown.Select(b => new List<string>
        {
            b.TaxDescription,
            b.TaxRate.ToString("0.#") + "%",
            b.SalesOutputTax.ToString("N2"),
            b.RecordedPurchaseTax.ToString("N2")
        }).ToList();
        var totals = new List<string> { "", "الإجمالي", _report.TotalBreakdownSalesTax.ToString("N2"), _report.TotalBreakdownPurchaseTax.ToString("N2") };
        var note = Loc["TaxNotFinal"].Value + " — " + Loc["NetSalesTaxBeforeVat"].Value + ": " + _report.NetSalesTaxBeforeVat.ToString("N2");

        return new GenericReportTable
        {
            TitleAr = Loc["TaxReconciliation"].Value,
            Headers = headers,
            Rows = rows,
            Totals = totals,
            ParamSummary = $"{_from:yyyy-MM-dd} → {_to:yyyy-MM-dd}",
            FooterNote = note,
            Landscape = true
        };
    }

    /// <summary>عرض التسوية في نافذة منبثقة (Excel/PDF/طباعة).</summary>
    private async Task OpenExportPopup()
    {
        if (_report is null) return;
        var table = BuildGenericTable();
        await Dialogs.ShowAsync<ReportPopup>(
            Loc["TaxReconciliation"].Value,
            new DialogParameters { ["Table"] = table, ["Brand"] = _brand },
            new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true });
    }
}

