    @* ══════════════════════════════════════════════════════════════════════════
       سندات القبض والصرف + قيود المستندات التشغيلية (المرحلة D)
       تُبنى هاتان القائمتان من فهرس التقارير نفسه (ReportsCatalog) عبر ByKeys —
       فلا أسماء ولا روابط ثابتة في الواجهة، ولا يمكن أن يظهر تقرير مسجَّل بلا بطاقة أو العكس.
       الروابط تفتح الصفحة العامة /reports/builtin/{key} التي تستخدم نفس المحرّك والعرض والتصدير.
       ══════════════════════════════════════════════════════════════════════════ *@
    <section class="repdash-section">
        <div class="repdash-section-head">
            <h2>@Loc["RepDashVouchersSection"]</h2>
            <span>@Loc["RepDashVouchersSub"]</span>
        </div>
        <div class="repdash-card-grid">
            @foreach (var def in ReportsCatalog.ByKeys(ReportsCatalog.VoucherReportKeys))
            {
                <a class="repdash-card" style="--c:#2563EB" href="@ReportLink(def.Key)">
                    <span class="repdash-card-icon"><MudIcon Icon="@Icons.Material.Filled.RequestPage" /></span>
                    <span class="repdash-card-body"><span class="repdash-card-title">@ReportTitle(def)</span><span class="repdash-card-sub">@Loc["RepDashVouchersSub"]</span></span>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="repdash-card-arrow" />
                </a>
            }
        </div>
    </section>

    <section class="repdash-section">
        <div class="repdash-section-head">
            <h2>@Loc["RepDashEntriesSection"]</h2>
            <span>@Loc["RepDashEntriesSub"]</span>
        </div>
        <div class="repdash-card-grid">
            @foreach (var def in ReportsCatalog.ByKeys(ReportsCatalog.DocumentEntryReportKeys))
            {
                <a class="repdash-card" style="--c:#7C3AED" href="@ReportLink(def.Key)">
                    <span class="repdash-card-icon"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" /></span>
                    <span class="repdash-card-body"><span class="repdash-card-title">@ReportTitle(def)</span><span class="repdash-card-sub">@Loc["RepDashEntriesSub"]</span></span>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="repdash-card-arrow" />
                </a>
            }
        </div>
    </section>

    <div class="repdash-footer">
        <MudIcon Icon="@Icons.Material.Filled.Assessment" Size="Size.Small" Class="me-1" />
        @Loc["ReportsDashboardFooter"]
    </div>
</div>
</ModuleGuard>

@code {
    private decimal _cashOnHand;
    private decimal _ar;
    private decimal _ap;
    private decimal _inventoryValue;
    private long _lowStockCount;
    private decimal _monthSales;

    [Inject] private Microsoft.Extensions.DependencyInjection.IServiceScopeFactory ScopeFactory { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // كل استعلامات اللوحة داخل نطاق DI مستقل (سياق DbContext جديد) — يمنع
            // تعارض "A second operation was started on this context instance".
            using var scope = ScopeFactory.CreateScope();
            var balances = scope.ServiceProvider.GetRequiredService<IAccountBalanceService>();
            var items = scope.ServiceProvider.GetRequiredService<IItemService>();
            var invoices = scope.ServiceProvider.GetRequiredService<ISalesInvoiceService>();

            // مصدر واحد للأرصدة: محرّك الأرصدة الموحّد (نفس مصدر شجرة الحسابات وميزان المراجعة)
            // بدل الرصيد المخزَّن Account.CurrentBalance الذي قد يتخلّف عن دفتر القيود.
            var tree = await balances.GetBalanceTreeAsync();
            _cashOnHand = SumTopMostCodes(tree.Flattened, "1100", "1105");
            _ar = Math.Abs(SumTopMostCodes(tree.Flattened, "1200"));
            _ap = Math.Abs(SumTopMostCodes(tree.Flattened, "2200"));

            var all = await items.GetAllAsync();
            _inventoryValue = all.Sum(i => i.CurrentStock * i.CostPrice);
            _lowStockCount = all.Count(i => i.CurrentStock <= 5m);

            var today = System.DateTime.Today;
            var from = new System.DateTime(today.Year, today.Month, 1);
            var to = new System.DateTime(today.Year, today.Month, today.Day, 23, 59, 59);
            _monthSales = (await invoices.GetInvoicesAsync())
                .Where(i => i.InvoiceDate >= from && i.InvoiceDate <= to)
                .Sum(i => i.TotalAmount);
        }
        catch { /* تبقى المؤشرات صفراً */ }
    }

    /// <summary>
    /// يجمع صافي أرصدة «أعلى عقدة مطابقة» لكل كود من أكواد الحسابات المطلوبة.
    /// لماذا؟ المحرّك الموحّد يجمّع الرصيد هرميًا (الأب = حركته + أبناؤه)، فجمع الأب وابنه معًا
    /// يحتسب المبلغ مرتين. تُتخطّى أي عقدة لها سلف مطابق ⇒ مجموع صحيح لأي شكل شجرة.
    /// </summary>
    private static decimal SumTopMostCodes(IEnumerable<AccountBalanceNodeDto> flat, params string[] codes)
    {
        var list = flat.ToList();
        var byCode = list.GroupBy(n => n.Code, StringComparer.Ordinal).ToDictionary(g => g.Key, g => g.ToList());
        var wanted = new HashSet<string>(codes, StringComparer.Ordinal);

        decimal total = 0m;
        foreach (var node in list.Where(n => wanted.Contains(n.Code)))
        {
            var hasMatchingAncestor = false;
            var parentCode = node.ParentAccountCode;
            var guard = 0;
            while (!string.IsNullOrEmpty(parentCode) && guard++ < 64)
            {
                if (wanted.Contains(parentCode)) { hasMatchingAncestor = true; break; }
                parentCode = byCode.TryGetValue(parentCode, out var parents) ? parents[0].ParentAccountCode : null;
            }

            if (!hasMatchingAncestor) total += node.NetBalance;
        }

        return total;
    }

    /// <summary>
    /// رابط فتح أي تقرير من فهرس التقارير: الصفحة العامة الموحّدة (نفس المحرّك/العرض/التصدير).
    /// مصدر واحد للروابط ⇒ لا يمكن أن تشير بطاقة إلى مسار غير موجود.
    /// </summary>
    private static string ReportLink(string key) => $"/reports/builtin/{key}";

    /// <summary>اسم التقرير من الفهرس نفسه (عربي/إنجليزي حسب ثقافة الواجهة) — لا تكرار للأسماء في الواجهة.</summary>
    private static string ReportTitle(ReportDef def)
        => System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? def.TitleEn : def.TitleAr;
}