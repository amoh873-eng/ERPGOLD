@page "/reports/purchase-tax-register"
@attribute [Authorize(Roles = "Reports")]
@using ERPSystem.Application.DTOs.Reports
<ModuleGuard ModuleKey="Reports">
@inject IReportService ReportService
@inject IStringLocalizer<SharedResources> Loc
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject ISystemSettingsService Settings

<PageTitle>@Loc["PurchaseTaxRegister"] - @Loc["AppName"]</PageTitle>
<PageHeader Title="@Loc["PurchaseTaxRegister"]" Icon="@Icons.Material.Filled.LocalShipping" />

@* ── قسم الفلاتر: نطاق التاريخ + زر التوليد ── *@
<MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid #E5E7EB">
    <MudText Typo="@Typo.subtitle2" Class="mb-2">@Loc["PurchaseTaxRegisterSubtitle"]</MudText>
    <MudGrid AlignItems="AlignItems.End" Spacing="3">
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="_from" Label="@Loc["FromDate"]" Variant="Variant.Outlined" T="DateTime?" AutoClose="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="_to" Label="@Loc["ToDate"]" Variant="Variant.Outlined" T="DateTime?" AutoClose="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GenerateAsync"
                       Disabled="_loading" FullWidth="true" StartIcon="@Icons.Material.Filled.Search">
                @Loc["GenerateReport"]
            </MudButton>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="OpenExportPopup"
                       Disabled="_report is null" FullWidth="true" StartIcon="@Icons.Material.Filled.PictureAsPdf">
                @Loc["View"] / @Loc["Print"]
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudPaper Elevation="0" Class="pa-8 d-flex justify-center">
        <MudProgressCircular Indeterminate="true" Size="Size.Large" />
    </MudPaper>
}
else if (_report is null)
{
    <MudPaper Elevation="0" Class="pa-6">
        <MudText Align="Align.Center" Style="color:#6B7280">@Loc["SelectDateRange"]</MudText>
    </MudPaper>
}
else if (_report.Rows.Count == 0)
{
    <MudPaper Elevation="0" Class="pa-6">
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@Loc["NoInvoicesForRange"]</MudAlert>
    </MudPaper>
}
else
{
    @* ── جدول السجل: صف لكل فاتورة ── *@
    <MudPaper Elevation="1" Class="overflow-x-auto">
        <MudTable Items="_report.Rows" Hover="true" Dense="true" Striped="true">
            <HeaderContent>
                <MudTh>@Loc["Date"]</MudTh>
                <MudTh>@Loc["InvoiceNumber"]</MudTh>
                <MudTh>@Loc["Supplier"]</MudTh>
                <MudTh Class="justify-end">@Loc["GrossTotal"]</MudTh>
                <MudTh Class="justify-end">@Loc["DiscountAmount"]</MudTh>
                <MudTh Class="justify-end">@Loc["NetBeforeTax"]</MudTh>
                <MudTh Class="justify-end">@Loc["TaxAmount"]</MudTh>
                <MudTh Class="justify-end">@Loc["Total"]</MudTh>
                <MudTh>@Loc["TaxRates"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.InvoiceDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>@context.InvoiceNumber</MudTd>
                <MudTd>@context.SupplierName</MudTd>
                <MudTd><MoneyDisplay Amount="context.ItemTotal" /></MudTd>
                <MudTd><MoneyDisplay Amount="context.DiscountTotal" /></MudTd>
                <MudTd><MoneyDisplay Amount="context.NetTaxable" /></MudTd>
                <MudTd><MoneyDisplay Amount="context.TaxTotal" /></MudTd>
                <MudTd><MoneyDisplay Amount="context.TotalInclTax" /></MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@context.TaxRates</MudChip></MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" Color="Color.Info"
                                   OnClick="() => OpenDetails(context)" Title="@Loc["Details"]" />
                </MudTd>
            </RowTemplate>
        </MudTable>

        @* ── صف الإجماليات ── *@
        <MudPaper Elevation="0" Class="pa-3" Style="border-top:2px solid #E5E7EB;background:#F9FAFB;">
            <MudGrid Spacing="2">
                <MudItem xs="6" sm="3"><MudText Typo="@Typo.body2">@Loc["TotalInvoices"]: <strong>@_report.Rows.Count</strong></MudText></MudItem>
                <MudItem xs="6" sm="3"><MudText Typo="@Typo.body2">@Loc["GrossTotal"]: <MoneyDisplay Amount="_report.TotalItemTotal" /></MudText></MudItem>
                <MudItem xs="6" sm="3"><MudText Typo="@Typo.body2">@Loc["TaxAmount"]: <MoneyDisplay Amount="_report.TotalTax" /></MudText></MudItem>
                <MudItem xs="6" sm="3"><MudText Typo="@Typo.body2">@Loc["Total"]: <MoneyDisplay Amount="_report.TotalInclTax" /></MudText></MudItem>
            </MudGrid>
        </MudPaper>
    </MudPaper>
}
</ModuleGuard>
@code {
    private DateTime? _from = new DateTime(DateTime.Today.AddMonths(-1).Year, DateTime.Today.AddMonths(-1).Month, 1);
    private DateTime? _to = DateTime.Today;
    private bool _loading;
    private PurchaseTaxRegisterDto? _report;
    private string _brand = "ERP";

    protected override async Task OnInitializedAsync()
    {
        try { var s = await Settings.GetAsync(); _brand = s.AppDisplayName ?? "ERP"; } catch { }
    }

    /// <summary>توليد السجل حسب نطاق التاريخ المحدد (مع تحقق من صحة النطاق).</summary>
    private async Task GenerateAsync()
    {
        if (!_from.HasValue || !_to.HasValue)
        {
            Snackbar.Add(Loc["DateRangeRequired"], Severity.Warning);
            return;
        }
        if (_from.Value.Date > _to.Value.Date)
        {
            Snackbar.Add(Loc["InvalidDateRange"], Severity.Warning);
            return;
        }

        _loading = true;
        try
        {
            _report = await ReportService.GetPurchaseTaxRegisterAsync(_from.Value.Date, _to.Value.Date);
            if (_report.Rows.Count == 0)
                Snackbar.Add(Loc["NoInvoicesForRange"].Value, Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _report = null;
        }
        finally { _loading = false; }
    }

    /// <summary>فتح نافذة تفاصيل أسطر الفاتورة.</summary>
    private async Task OpenDetails(PurchaseTaxRegisterRow row)
    {
        await Dialogs.ShowAsync<PurchaseTaxRegisterDetailsDialog>(
            Loc["PurchaseTaxRegisterDetails"].Value + " — " + row.InvoiceNumber,
            new DialogParameters { ["Invoice"] = row },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
    }

    /// <summary>بناء GenericReportTable لفتح نافذة العرض/الطباعة/التصدير (Excel/PDF عبر ReportPopup).</summary>
    private GenericReportTable BuildGenericTable()
    {
        var headers = new List<string> { "التاريخ", "رقم الفاتورة", "المورد", "إجمالي الأصناف", "الخصم", "الصافي", "الضريبة", "الإجمالي", "النسب" };
        var rows = _report!.Rows.Select(r => new List<string>
        {
            r.InvoiceDate.ToString("yyyy-MM-dd"),
            r.InvoiceNumber,
            r.SupplierName,
            r.ItemTotal.ToString("N2"),
            r.DiscountTotal.ToString("N2"),
            r.NetTaxable.ToString("N2"),
            r.TaxTotal.ToString("N2"),
            r.TotalInclTax.ToString("N2"),
            r.TaxRates
        }).ToList();

        var totals = new List<string> { "", "الإجمالي", _report.Rows.Count.ToString("N0"), _report.TotalItemTotal.ToString("N2"), _report.TotalDiscount.ToString("N2"), _report.TotalNetTaxable.ToString("N2"), _report.TotalTax.ToString("N2"), _report.TotalInclTax.ToString("N2"), "" };

        return new GenericReportTable
        {
            TitleAr = Loc["PurchaseTaxRegister"].Value,
            Headers = headers,
            Rows = rows,
            Totals = totals,
            ParamSummary = $"{_from:yyyy-MM-dd} → {_to:yyyy-MM-dd}",
            Landscape = true
        };
    }

    /// <summary>عرض السجل في نافذة منبثقة (Excel/PDF/طباعة).</summary>
    private async Task OpenExportPopup()
    {
        if (_report is null) return;
        var table = BuildGenericTable();
        await Dialogs.ShowAsync<ReportPopup>(
            Loc["PurchaseTaxRegister"].Value,
            new DialogParameters { ["Table"] = table, ["Brand"] = _brand },
            new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true });
    }
}

