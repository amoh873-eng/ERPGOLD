@* نموذج حوار لإنشاء فاتورة مشتريات جديدة (المورد + البنود) *@
@inject IStringLocalizer<SharedResources> Loc
@inject IJSRuntime Js

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
            }
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid" @bind-Value="_supplierId" Label="@Loc["Supplier"]" Required="true" RequiredError="@Loc["SupplierRequired"]" Variant="Variant.Outlined">
                        @foreach (var s in _suppliers)
                        {
                            <MudSelectItem T="Guid" Value="@s.Id">@s.Code - @s.NameAr</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid" @bind-Value="_warehouseId" Label="@Loc["Warehouse"]" Required="true" RequiredError="@Loc["WarehouseRequired"]" Variant="Variant.Outlined">
                        @foreach (var w in _warehouses)
                        {
                            <MudSelectItem T="Guid" Value="@w.Id">@w.Code - @w.NameAr</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" Value="_invoiceType" ValueChanged="OnInvoiceTypeChanged" Label="@Loc["InvoiceType"]" Required="true" Variant="Variant.Outlined">
                        <MudSelectItem T="int" Value="1">@Loc["InvoiceTypeCash"]</MudSelectItem>
                        <MudSelectItem T="int" Value="2">@Loc["InvoiceTypeCredit"]</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_invoiceDate" Label="@Loc["Date"]" Variant="Variant.Outlined" T="DateTime?" AutoClose="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    @* D-04: خيارات طريقة الدفع تتبع نوع الفاتورة ⇒ يستحيل إرسال توليفة متعارضة من الواجهة *@
                    <MudSelect T="int" Value="_paymentMethod" ValueChanged="OnPaymentMethodChanged" Label="@Loc["PaymentMethod"]" Required="true" Variant="Variant.Outlined">
                        @if (_invoiceType == 1)
                        {
                            <MudSelectItem T="int" Value="3">نقدي</MudSelectItem>
                        }
                        else
                        {
                            <MudSelectItem T="int" Value="1">@Loc["PaymentOnAccount"]</MudSelectItem>
                            <MudSelectItem T="int" Value="2">@Loc["PaymentCheck"]</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            @if (_paymentMethod == 2)
            {
                <MudPaper Class="mb-3 pa-3" Style="background:#EEF2FF;border:1px solid #4F46E5;border-radius:10px;">
                    <MudText Typo="Typo.subtitle2" Style="font-weight:700;">@Loc["PaymentCheck"]</MudText>
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" @bind-Value="_checkNumber" Label="@Loc["CheckNumber"]" Required="true" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" @bind-Value="_checkBankName" Label="@Loc["CheckBankName"]" Required="true" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" @bind-Value="_checkBranch" Label="@Loc["CheckBranch"]" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="_checkIssueDate" Label="@Loc["CheckIssueDate"]" Variant="Variant.Outlined" T="DateTime?" AutoClose="true" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="_checkDueDate" Label="@Loc["CheckDueDate"]" Required="true" Variant="Variant.Outlined" T="DateTime?" AutoClose="true" Dense="true" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }

            @* ── لوحة الاستلام بالباركود (وضع إضافي — لا يستبدل الإدخال اليدوي) ── *@
            <MudPaper Class="mb-3 pa-3" Style="background:#F5F3FF;border:1px dashed #C4B5FD;border-radius:10px;">
                <div style="display:flex;align-items:center;gap:10px;">
                    <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Style="color:#6D5BD0;" />
                    <MudText Typo="Typo.subtitle2" Style="font-weight:700;flex:1;">@Loc["BarcodeReceive"]</MudText>
                    <MudButton Variant="@(_receiveMode ? Variant.Filled : Variant.Outlined)"
                          Color="@(_receiveMode ? Color.Primary : Color.Default)"
                          StartIcon="@Icons.Material.Filled.QrCodeScanner"
                          OnClick="ToggleReceiveMode"
                          UserAttributes="@(new Dictionary<string, object> { { "id", "barcodeReceiveToggle" }, { "aria-pressed", _receiveMode ? "true" : "false" } })">
                    @Loc["BarcodeReceive"]
                </MudButton>
                </div>

                @if (_receiveMode)
                {
                    <MudTextField @ref="_scanInput"
                                  @bind-Value="_scanTerm" T="string"
                                  Placeholder="@Loc["BarcodeReceivePlaceholder"]"
                                  Variant="Variant.Outlined" Dense="true" Class="mt-2"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true" OnKeyDown="HandleScanKeyDown" />

                    @if (_lastScan is { } last)
                    {
                        <MudAlert Severity="Severity.Success" Class="mt-2" Dense="true">
                            @Loc["BarcodeScanOk", last.Name, last.QtyAdded, last.LineQty]
                        </MudAlert>
                    }
                    else if (_scanFailed)
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-2" Dense="true">
                            @Loc["BarcodeScanNotFound"]
                        </MudAlert>
                    }
                    <MudText Typo="Typo.caption" Class="pos-muted mt-1">@Loc["BarcodeReceiveHint"]</MudText>
                }
            </MudPaper>

            <MudText Typo="Typo.subtitle2" Class="mt-2">@Loc["Lines"]</MudText>

            @foreach (var line in _lines)
            {
                <MudGrid Class="mb-1 align-items-center">
                    <MudItem xs="12" sm="5">
                        <MudSelect T="Guid" Value="@line.ItemId" ValueChanged="@(id => OnLineItemChanged(line, id))" Label="@Loc["Item"]" Variant="Variant.Outlined" Dense="true">
                            @foreach (var it in _items)
                            {
                                <MudSelectItem T="Guid" Value="@it.Id">@it.Code - @it.NameAr</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudNumericField Culture="@CultureInfo.InvariantCulture" T="decimal" DecimalPlaces="2" Format="0.00" @bind-Value="line.Quantity" Label="@Loc["Qty"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudNumericField Culture="@CultureInfo.InvariantCulture" T="decimal" DecimalPlaces="2" Format="0.00" @bind-Value="line.UnitCost" Label="@Loc["UnitCost"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         ReadOnly="@(!_canEditPrice)"
                                         HelperText="@(_canEditPrice ? null : PriceLockHint)" />
                    </MudItem>
                    <MudItem xs="12" sm="2" Class="d-flex align-items-center">
                        <MudText Typo="Typo.caption" Style="color:var(--erp-muted)">
                            @Loc["SalesTax"]: @((LineTaxRate(line)).ToString("0.##"))% (@((LineTaxAmount(line)).ToString("N2")))
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" sm="1" Class="d-flex align-items-center">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(e => RemoveLine(line))" />
                    </MudItem>
                </MudGrid>
                @if (line.RequiresExpiry)
                {
                    <MudGrid Class="mb-2 align-items-center">
                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="line.ExpiryDate" Label="@Loc["ExpiryDate"]" Variant="Variant.Outlined" T="DateTime?" AutoClose="true" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="line.BatchNumber" Label="@Loc["BatchNumber"]" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                    </MudGrid>
                }
            }

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddLine" Class="mt-2">@Loc["AddLine"]</MudButton>

            <MudPaper Elevation="1" Class="pa-3 mt-4">
                <MudText Typo="Typo.body2">@Loc["SubTotal"]: @_subTotal.ToString("N2")</MudText>
                <MudText Typo="Typo.body2">@Loc["TaxAmount"]: @_taxAmount.ToString("N2")</MudText>
                <MudText Typo="Typo.h6" Class="mt-2">@Loc["Total"]: @_total.ToString("N2")</MudText>
            </MudPaper>

            <MudItem xs="12" Class="mt-3">
                <MudTextField @bind-Value="_note" Label="@Loc["Notes"]" Lines="2" Variant="Variant.Outlined" />
            </MudItem>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">@Loc["Cancel"]</MudButton>
        <MudButton OnClick="SubmitAsync" Disabled="_submitting" Variant="Variant.Filled" Color="Color.Primary">
            @(_submitting ? "جارٍ الحفظ…" : Loc["SaveInvoice"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Inject] private IPurchaseInvoiceService InvoiceService { get; set; } = default!;
    [Inject] private ISupplierService SupplierService { get; set; } = default!;
    [Inject] private IWarehouseService WarehouseService { get; set; } = default!;
    [Inject] private IItemService ItemService { get; set; } = default!;

    private class LineEditor
    {
        public Guid ItemId { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal UnitCost { get; set; }

        /// <summary>تاريخ انتهاء الصلاحية (اختياري كإدخال، يُحوَّل إلى DateOnly عند الحفظ).</summary>
        public DateTime? ExpiryDate { get; set; }

        /// <summary>رقم الدفعة/اللوت (اختياري).</summary>
        public string? BatchNumber { get; set; }

        public bool RequiresExpiry { get; set; }

        /// <summary>اسم الصنف لأغراض العرض في آخر مسح (ملء من Item عند الإنشاء).</summary>
        public string? ItemName { get; set; }
    }

    /// <summary>حالة آخر مسح ناجح في وضع الاستلام بالباركود.</summary>
    private sealed record LastScanInfo(string Name, decimal QtyAdded, decimal LineQty);

    private MudForm? _form;
    private List<SupplierDto> _suppliers = new();
    private List<WarehouseDto> _warehouses = new();
    private List<ItemDto> _items = new();
    private List<LineEditor> _lines = new();

    private Guid _supplierId;
    private Guid _warehouseId;
    private int _invoiceType = 1;
    // D-04: الافتراضي للنوع «نقدي» ⇒ طريقة الدفع «نقدي» (3) لا «آجل».
    private int _paymentMethod = 3;
    private string? _checkNumber;
    private string? _checkBankName;
    private string? _checkBranch;
    private DateTime? _checkIssueDate = DateTime.Today;
    private DateTime? _checkDueDate = DateTime.Today.AddMonths(1);
    private DateTime? _invoiceDate = DateTime.Today;
    private string? _note;
    private string? _error;

    private bool _submitting;

    /// <summary>
    /// D-01/D-06: مفتاح تمييز واحد لكل «نية حفظ» — يُولَّد عند فتح الحوار.
    /// إعادة المحاولة بنفس المفتاح لا تُنشئ فاتورة ثانية (تُعاد النتيجة الأصلية)،
    /// فينتهي غموض الواجهة بلا تكرار. ويُجدَّد المفتاح فقط بعد نجاح أو إلغاء.
    /// </summary>
    private Guid _idempotencyKey = Guid.NewGuid();

    /// <summary>D-04: مزامنة طريقة الدفع مع نوع الفاتورة (نقدي ⇒ 3 · آجل ⇒ 1).</summary>
    private void OnInvoiceTypeChanged(int t)
    {
        _invoiceType = t;
        _paymentMethod = t == 1 ? 3 : 1;
    }

    private void OnPaymentMethodChanged(int pm) => _paymentMethod = pm;

    // ── حالة وضع الاستلام بالباركود ──
    private bool _receiveMode;
    private string _scanTerm = string.Empty;
    private MudTextField<string>? _scanInput;
    private bool _refocusScan;
    private LastScanInfo? _lastScan;
    private bool _scanFailed;

    private ItemDto? LineItem(LineEditor line) => _items.FirstOrDefault(i => i.Id == line.ItemId);
    private decimal LineTaxRate(LineEditor line) => LineItem(line)?.TaxRate ?? 0m;
    private decimal LineTaxAmount(LineEditor line) => Math.Round(Math.Round(line.Quantity * line.UnitCost, 2) * LineTaxRate(line) / 100m, 2);
    private decimal _subTotal => Math.Round(_lines.Sum(l => l.Quantity * l.UnitCost), 2);
    private decimal _taxAmount => Math.Round(_lines.Sum(l => LineTaxAmount(l)), 2);
    private decimal _total => Math.Round(_subTotal + _taxAmount, 2);

    protected override async Task OnInitializedAsync()
    {
        await LoadPricePermissionAsync();

        _suppliers = await SupplierService.GetAllAsync();
        _warehouses = await WarehouseService.GetAllAsync();
        _items = await ItemService.GetAllAsync();

        _supplierId = _suppliers.FirstOrDefault(s => s.IsActive)?.Id ?? Guid.Empty;
        _warehouseId = _warehouses.FirstOrDefault(w => w.IsDefault)?.Id
                       ?? _warehouses.FirstOrDefault()?.Id
                       ?? Guid.Empty;

        AddLine();
    }

    // ── Requirement 3: تكلفة الوحدة اليدوية في فاتورة المشتريات ──
    // فاتورة المشتريات → الصلاحية الحالية المناسبة: Purchases.Edit (دور الموديول «Purchases»).
    // القيمة الافتراضية في الشاشة = Item.CostPrice ⇒ المستخدم غير المصرّح يحفظ بالسعر النظامي،
    // وأي محاولة لتغييرها من خارج الشاشة يرفضها الحارس الخلفي.
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    private bool _canEditPrice;
    private const string PriceLockHint = "قراءة فقط — لا تملك صلاحية تعديل السعر يدويًا (Purchases.Edit)";

    private async Task LoadPricePermissionAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            _canEditPrice = ManualPriceRules.IsAuthorized(auth.User, ManualPriceModules.Purchases);
        }
        catch { _canEditPrice = false; } // فشل مغلق: أي تعذّر لقراءة الهوية ⇒ لا تعديل يدوي
    }

    private void AddLine() => _lines.Add(new LineEditor());

    private void RemoveLine(LineEditor line)
    {
        if (_lines.Count > 1) _lines.Remove(line);
    }

    private Task OnLineItemChanged(LineEditor line, Guid id)
    {
        line.ItemId = id;
        var item = _items.FirstOrDefault(i => i.Id == id);
        if (item is not null)
        {
            line.UnitCost = item.CostPrice;
            line.ItemName = item.NameAr;
            // إلزامي للدفعات أيضاً — ليس فقط TracksExpiry (الخدمة تفرضه عند الاستلام للصنف TracksBatches)
            line.RequiresExpiry = item.TracksExpiry || item.TracksBatches;
        }
        return Task.CompletedTask;
    }

    /// <summary>
    /// معالجة المسح (Enter) في وضع الاستلام بالباركود — بحث موحّد كـ POS:
    /// باركود مطابق تماماً أولاً، ثم بداية الكود/الاسم. يُحدّث قائمة _lines في الذاكرة فقط
    /// (لا استدعاء قاعدة بيانات أثناء المسح) — لذا لا توجد أي فرصة لخطأ تزامن DbContext
    /// من مسح سريع متكرر. الحفظ يتم مرة واحدة عند الترحيل عبر الخدمة نفسها.
    /// </summary>
    private void HandleScanKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;

        var term = _scanTerm?.Trim();
        if (string.IsNullOrWhiteSpace(term)) return;

        _scanTerm = string.Empty;
        _scanFailed = false;

        // البحث الموحّد: باركود مطابق تماماً → ثم بداية الكود/الاسم (نفس منطق POS)
        var item = _items.FirstOrDefault(i => !string.IsNullOrEmpty(i.Barcode)
                                              && string.Equals(i.Barcode, term, StringComparison.OrdinalIgnoreCase));
        item ??= _items.FirstOrDefault(i =>
            i.Code.StartsWith(term, StringComparison.OrdinalIgnoreCase)
            || i.NameAr.StartsWith(term, StringComparison.OrdinalIgnoreCase)
            || (i.NameEn != null && i.NameEn.StartsWith(term, StringComparison.OrdinalIgnoreCase)));

        if (item is null)
        {
            _scanFailed = true;
            _lastScan = null; // إظهار رسالة الخطأ بدل رسالة النجاح السابقة
            _refocusScan = true;
            return;
        }

        var line = _lines.FirstOrDefault(l => l.ItemId == item.Id);
        if (line is null)
        {
            // أزل سطر العنصر الفارغ الافتراضي (يأتي من AddLine() التمهيدي) عند أول مسح
            _lines.RemoveAll(l => l.ItemId == Guid.Empty);

            line = new LineEditor
            {
                ItemId = item.Id,
                Quantity = 1,
                UnitCost = item.CostPrice,
                RequiresExpiry = item.TracksExpiry || item.TracksBatches,
                ItemName = item.NameAr
            };
            _lines.Add(line);
            _lastScan = new LastScanInfo(item.NameAr, 1, 1);
        }
        else
        {
            line.Quantity += 1;
            _lastScan = new LastScanInfo(line.ItemName ?? item.NameAr, 1, line.Quantity);
        }

        _refocusScan = true;
        // امسح حقل المسح برمجياً (MudBlazor Clear يمسح أيضاً Text الداخلي ← حقل فارغ للرمز التالي)
        _scanInput?.Clear();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // إعادة التركيز إلى حقل المسح بعد كل مسح (الماسح يرسل دون أن يركز المستخدم بنفسه)
        if (_refocusScan)
        {
            _refocusScan = false;
            try
            {
                if (_scanInput is not null) await _scanInput.FocusAsync();
            }
            catch { /* تجاهل — التركيز غير حرج */ }
        }

        // إرفاق ممتص الطفرة (باختصار مستند إليه) لحقل المسح — نفس نمط POS:
        // فيدفع ضغطة واحدة لكل مسح بدل إغراق الدائرة بكل ضغطة مفتاح
        if (_receiveMode)
        {
            try
            {
                var module = await Js.InvokeAsync<IJSObjectReference>("import", "./purchaseScan.js");
                await module.InvokeVoidAsync("attach");
            }
            catch { /* لا يوقف تجربة المسح لو فشل تحميل الموديول */ }
        }
    }

    private void ToggleReceiveMode()
    {
        _receiveMode = !_receiveMode;
        if (_receiveMode) _refocusScan = true;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        if (_submitting) return; // حارس النقر المزدوج — نفس نمط حارس POS
        // السطور الفارغة (placeholder) لا تُعد بنوداً — أزل أي سطر لم يُحدَّد صنفه
        _lines.RemoveAll(l => l.ItemId == Guid.Empty);
        if (_lines.Count == 0) { _error = Loc["LineItemRequired"]; return; }

        await _form!.Validate();
        if (!_form.IsValid) return;

        if (_lines.Any(l => l.Quantity <= 0)) { _error = Loc["QuantityPositive"]; return; }
        if (_lines.Any(l => l.RequiresExpiry && !l.ExpiryDate.HasValue)) { _error = Loc["ExpiryDateRequired"]; return; }

        _error = null;
        _submitting = true;
        try
        {
            var saved = await InvoiceService.CreateAsync(new CreatePurchaseInvoiceDto
            {
                SupplierId = _supplierId,
                WarehouseId = _warehouseId,
                InvoiceDate = _invoiceDate ?? DateTime.Today,
                InvoiceType = _invoiceType,
                PaymentMethod = _paymentMethod,
                IdempotencyKey = _idempotencyKey,
                CheckNumber = _checkNumber,
                CheckBankName = _checkBankName,
                CheckBranch = _checkBranch,
                CheckIssueDate = _checkIssueDate,
                CheckDueDate = _checkDueDate,
                Note = _note,
                Lines = _lines.Select(l => new CreatePurchaseInvoiceLineDto
                {
                    ItemId = l.ItemId,
                    Quantity = l.Quantity,
                    UnitCost = l.UnitCost,
                    ExpiryDate = l.ExpiryDate.HasValue ? DateOnly.FromDateTime(l.ExpiryDate.Value) : null,
                    BatchNumber = l.BatchNumber
                }).ToList()
            });
            // D-06: إشارة نجاح صريحة — نُعيد رقم الفاتورة للصفحة لعرضه، ونُجدّد مفتاح التمييز
            // حتى يُعدّ الحفظ التالي نية جديدة مستقلة (D-01).
            _idempotencyKey = Guid.NewGuid();
            MudDialog.Close(DialogResult.Ok(saved.InvoiceNumber));
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _submitting = false; }
    }
}

