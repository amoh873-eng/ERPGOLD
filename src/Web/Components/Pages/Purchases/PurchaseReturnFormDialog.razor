@* نموذج حوار لإنشاء مردود مشتريات مرتبط بفاتورة أصلية *@
@inject IStringLocalizer<SharedResources> Loc

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
            }
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="PurchaseInvoiceDto" Value="_selectedInvoice" ValueChanged="OnInvoiceChanged"
                                     Label="@Loc["OriginalInvoice"]" Required="true" RequiredError="@Loc["OriginalInvoiceRequired"]"
                                     Variant="Variant.Outlined" Dense="true"
                                     ToStringFunc="@InvoiceDisplay"
                                     SearchFunc="@SearchInvoices" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid" @bind-Value="_warehouseId" Label="@Loc["Warehouse"]" Required="true" RequiredError="@Loc["WarehouseRequired"]" Variant="Variant.Outlined">
                        @foreach (var w in _warehouses)
                        {
                            <MudSelectItem T="Guid" Value="@w.Id">@w.Code - @w.NameAr</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_returnDate" Label="@Loc["Date"]" Variant="Variant.Outlined" T="DateTime?" AutoClose="true" />
                </MudItem>
            </MudGrid>

            @if (_lines.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4">@Loc["ReturnItemsHint"]</MudText>
                <MudTable Items="_lines" Hover="true" Dense="true" Elevation="1" Class="mt-2">
                    <HeaderContent>
                        <MudTh>@Loc["Item"]</MudTh>
                        <MudTh>@Loc["QuantityPurchased"]</MudTh>
                        <MudTh>@Loc["UnitCost"]</MudTh>
                        <MudTh>@Loc["ReturnQuantity"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.ItemCode - @context.ItemNameAr</MudTd>
                        <MudTd>@context.MaxQuantity.ToString("N0")</MudTd>
                        <MudTd>@context.UnitCost.ToString("N2")</MudTd>
                        <MudTd>
                            <MudNumericField Culture="@CultureInfo.InvariantCulture" T="decimal" DecimalPlaces="2" Format="0.00" @bind-Value="context.ReturnQuantity" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="context.MaxQuantity" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <MudText Typo="Typo.h6" Class="mt-3">@Loc["TotalReturn"]: @_returnTotal.ToString("N2")</MudText>
            }

            <MudItem xs="12" Class="mt-3">
                <MudTextField @bind-Value="_note" Label="@Loc["Notes"]" Lines="2" Variant="Variant.Outlined" />
            </MudItem>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">@Loc["Cancel"]</MudButton>
        <MudButton OnClick="SubmitAsync" Variant="Variant.Filled" Color="Color.Primary">@Loc["SaveAndPost"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Inject] private IPurchaseReturnService ReturnService { get; set; } = default!;
    [Inject] private IPurchaseInvoiceService InvoiceService { get; set; } = default!;
    [Inject] private IWarehouseService WarehouseService { get; set; } = default!;

    private class ReturnLineEditor
    {
        public Guid ItemId { get; set; }
        public string ItemCode { get; set; } = string.Empty;
        public string ItemNameAr { get; set; } = string.Empty;
        public decimal MaxQuantity { get; set; }
        public decimal UnitCost { get; set; }
        public decimal ReturnQuantity { get; set; }
    }

    private MudForm? _form;
    private List<PurchaseInvoiceDto> _invoices = new();
    private List<WarehouseDto> _warehouses = new();
    private List<ReturnLineEditor> _lines = new();

    private Guid _invoiceId;
    private PurchaseInvoiceDto? _selectedInvoice;
    private Guid _warehouseId;
    private DateTime? _returnDate = DateTime.Today;
    private string? _note;
    private string? _error;

    private decimal _returnTotal => Math.Round(_lines.Sum(l => l.ReturnQuantity * l.UnitCost), 2);

    protected override async Task OnInitializedAsync()
    {
        _invoices = await InvoiceService.GetInvoicesAsync();
        _warehouses = await WarehouseService.GetAllAsync();
        _warehouseId = _warehouses.FirstOrDefault(w => w.IsDefault)?.Id
                       ?? _warehouses.FirstOrDefault()?.Id
                       ?? Guid.Empty;
    }

    /// <summary>نص العرض للفاتورة في حقل البحث.</summary>
    private static string InvoiceDisplay(PurchaseInvoiceDto? inv) =>
        inv is null ? string.Empty : $"{inv.InvoiceNumber} — {inv.SupplierName}";

    /// <summary>البحث عن فاتورة بالكتابة (رقم الفاتورة أو المورد) بدل قائمة منسدلة طويلة.</summary>
    private Task<IEnumerable<PurchaseInvoiceDto>> SearchInvoices(string text, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(text))
            return Task.FromResult<IEnumerable<PurchaseInvoiceDto>>(_invoices);
        IEnumerable<PurchaseInvoiceDto> filtered = _invoices.Where(i =>
            i.InvoiceNumber.Contains(text, StringComparison.OrdinalIgnoreCase) ||
            (i.SupplierName != null && i.SupplierName.Contains(text, StringComparison.OrdinalIgnoreCase)));
        return Task.FromResult(filtered);
    }

    private async Task OnInvoiceChanged(PurchaseInvoiceDto? inv)
    {
        _selectedInvoice = inv;
        _error = null;

        if (inv is null) { _lines = new(); _invoiceId = Guid.Empty; return; }

        _invoiceId = inv.Id;
        var invoice = await InvoiceService.GetByIdAsync(inv.Id);
        if (invoice is null)
        {
            _lines = new();
            return;
        }

        _warehouseId = invoice.WarehouseId;
        _lines = invoice.Lines.Select(l => new ReturnLineEditor
        {
            ItemId = l.ItemId,
            ItemCode = l.ItemCode,
            ItemNameAr = l.ItemNameAr,
            MaxQuantity = l.Quantity,
            UnitCost = l.UnitCost
        }).ToList();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        if (_invoiceId == Guid.Empty) { _error = Loc["SelectOriginalInvoice"]; return; }

        var linesToReturn = _lines.Where(l => l.ReturnQuantity > 0).ToList();
        if (linesToReturn.Count == 0) { _error = Loc["SelectReturnQuantity"]; return; }

        _error = null;
        try
        {
            await ReturnService.CreateAsync(new CreatePurchaseReturnDto
            {
                PurchaseInvoiceId = _invoiceId,
                WarehouseId = _warehouseId,
                ReturnDate = _returnDate ?? DateTime.Today,
                Note = _note,
                Lines = linesToReturn.Select(l => new CreatePurchaseReturnLineDto
                {
                    ItemId = l.ItemId,
                    Quantity = l.ReturnQuantity,
                    UnitCost = l.UnitCost
                }).ToList()
            });
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}