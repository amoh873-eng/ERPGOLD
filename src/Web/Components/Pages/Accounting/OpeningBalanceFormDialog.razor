@* نموذج حوار لإنشاء/تعديل مسودة دفعة أرصدة افتتاحية — الحسابات المتحركة (Leaf) فقط *@
@inject IStringLocalizer<SharedResources> Loc

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
            }

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudNumericField Culture="@CultureInfo.InvariantCulture" T="int" @bind-Value="_fiscalYear"
                                     Label="@Loc["OpeningBalanceFiscalYear"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_entryDate" Label="@Loc["EntryDate"]"
                                   Variant="Variant.Outlined" T="DateTime?" AutoClose="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_reference" Label="@Loc["ReferenceDocument"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_description" Label="@Loc["DescriptionStatement"]" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>

            <MudAlert Severity="Severity.Info" Dense="true" Class="my-2">@Loc["OpeningBalanceAccountsLeafHint"]</MudAlert>

            <MudText Typo="Typo.subtitle2" Class="mt-2">@Loc["EntryLines"]</MudText>

            @foreach (var line in _lines)
            {
                <MudGrid Class="mb-1 align-items-center">
                    <MudItem xs="12" sm="5">
                        <MudSelect T="Guid" @bind-Value="line.AccountId" Label="@Loc["Account"]"
                                   Variant="Variant.Outlined" Dense="true">
                            @foreach (var acc in _accounts)
                            {
                                <MudSelectItem T="Guid" Value="@acc.Id">@acc.Code - @acc.NameAr</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudNumericField Culture="@CultureInfo.InvariantCulture" T="decimal" DecimalPlaces="2" Format="0.00"
                                         @bind-Value="line.Debit" Label="@Loc["Debit"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudNumericField Culture="@CultureInfo.InvariantCulture" T="decimal" DecimalPlaces="2" Format="0.00"
                                         @bind-Value="line.Credit" Label="@Loc["Credit"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="1" Class="d-flex align-items-center">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       Disabled="@(_lines.Count <= 2)" OnClick="@(e => RemoveLine(line))" />
                    </MudItem>

                    @* البُعد التفصيلي: يظهر إلزاميًا على الحسابات الرقابية 1200/2200/1300 *@
                    @if (IsCustomerLine(line) || IsSupplierLine(line) || IsItemLine(line))
                    {
                        <MudItem xs="12">
                            @if (IsCustomerLine(line))
                            {
                                <MudSelect T="Guid?" @bind-Value="line.CustomerId" Dense="true" Variant="Variant.Outlined"
                                           Label="@Loc["OpeningBalanceCustomerDetail"]">
                                    @foreach (var c in _customers)
                                    {
                                        <MudSelectItem T="Guid?" Value="@((Guid?)c.Id)">@c.Code - @c.NameAr</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else if (IsSupplierLine(line))
                            {
                                <MudSelect T="Guid?" @bind-Value="line.SupplierId" Dense="true" Variant="Variant.Outlined"
                                           Label="@Loc["OpeningBalanceSupplierDetail"]">
                                    @foreach (var s in _suppliers)
                                    {
                                        <MudSelectItem T="Guid?" Value="@((Guid?)s.Id)">@s.Code - @s.NameAr</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else
                            {
                                <MudGrid Class="align-items-center">
                                    <MudItem xs="12" sm="4">
                                        <MudSelect T="Guid?" @bind-Value="line.ItemId" Dense="true" Variant="Variant.Outlined"
                                                   Label="@Loc["OpeningBalanceItemDetail"]">
                                            @foreach (var it in _items)
                                            {
                                                <MudSelectItem T="Guid?" Value="@((Guid?)it.Id)">@it.Code - @it.NameAr</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="3">
                                        <MudSelect T="Guid?" @bind-Value="line.WarehouseId" Dense="true" Variant="Variant.Outlined"
                                                   Label="@Loc["OpeningBalanceWarehouseDetail"]">
                                            @foreach (var w in _warehouses)
                                            {
                                                <MudSelectItem T="Guid?" Value="@((Guid?)w.Id)">@w.NameAr</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="6" sm="2">
                                        <MudNumericField Culture="@CultureInfo.InvariantCulture" T="decimal" DecimalPlaces="4"
                                                         @bind-Value="line.Quantity" Label="@Loc["OpeningBalanceQuantityDetail"]"
                                                         Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="6" sm="2">
                                        <MudNumericField Culture="@CultureInfo.InvariantCulture" T="decimal" DecimalPlaces="4"
                                                         @bind-Value="line.UnitCost" Label="@Loc["OpeningBalanceUnitCostDetail"]"
                                                         Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" sm="1">
                                        <MudText Typo="Typo.caption" Class="muted-text">
                                            @EffectiveDebit(line).ToString("N2")
                                        </MudText>
                                    </MudItem>
                                </MudGrid>
                            }
                        </MudItem>
                    }
                </MudGrid>
            }

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddLine" Class="mt-2">@Loc["AddLeg"]</MudButton>

            @* مجموع المدين/الدائن والفرق وحالة التوازن — قبل السماح بالحفظ/الترحيل *@
            <MudPaper Elevation="1" Class="pa-3 mt-4">
                <MudText Typo="Typo.body2">@Loc["DebitTotal"]: @_totalDebit.ToString("N2")</MudText>
                <MudText Typo="Typo.body2">@Loc["CreditTotal"]: @_totalCredit.ToString("N2")</MudText>
                <MudText Typo="Typo.body2" Color="@(_isBalanced ? Color.Success : Color.Error)">
                    @Loc["Difference"]: @_difference.ToString("N2") @(_isBalanced ? Loc["Balanced"] : Loc["Unbalanced"])
                </MudText>
            </MudPaper>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">@Loc["Cancel"]</MudButton>
        <MudButton OnClick="SubmitAsync" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_busy || !_isBalanced)">
            @Loc["Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>الدفعة المطلوب تعديلها (null = إنشاء مسودة جديدة).</summary>
    [Parameter] public OpeningBalanceBatchDto? Batch { get; set; }

    [Inject] private IOpeningBalanceService OpeningBalanceService { get; set; } = default!;
    [Inject] private IAccountService AccountService { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthState { get; set; } = default!;
    // تفصيل الرقابي (2026-10-25): قوائم الأطراف/الأصناف/المخازن لإلزام البند بتفصيله.
    [Inject] private ICustomerService CustomerService { get; set; } = default!;
    [Inject] private ISupplierService SupplierService { get; set; } = default!;
    [Inject] private IItemService ItemService { get; set; } = default!;
    [Inject] private IWarehouseService WarehouseService { get; set; } = default!;

    private sealed class LineEditor
    {
        public Guid AccountId { get; set; }
        public decimal Debit { get; set; }
        public decimal Credit { get; set; }

        // البُعد التفصيلي (يظهر فقط على الحسابات الرقابية 1200/2200/1300)
        public Guid? CustomerId { get; set; }
        public Guid? SupplierId { get; set; }
        public Guid? ItemId { get; set; }
        public Guid? WarehouseId { get; set; }
        public decimal Quantity { get; set; }
        public decimal UnitCost { get; set; }
    }

    private MudForm? _form;
    private List<AccountDto> _accounts = new();
    private List<LineEditor> _lines = new();
    private List<CustomerDto> _customers = new();
    private List<SupplierDto> _suppliers = new();
    private List<ItemDto> _items = new();
    private List<WarehouseDto> _warehouses = new();

    private int _fiscalYear = DateTime.Today.Year;
    private DateTime? _entryDate = DateTime.Today;
    private string? _reference;
    private string? _description;
    private string? _error;
    private bool _busy;

    /// <summary>كود الحساب المختار في البند (لفحص نوع التفصيل المطلوب).</summary>
    private string? AccountCodeOf(LineEditor line)
        => _accounts.FirstOrDefault(a => a.Id == line.AccountId)?.Code;

    private bool IsCustomerLine(LineEditor line) => AccountCodeOf(line) == "1200";

    private bool IsSupplierLine(LineEditor line) => AccountCodeOf(line) == "2200";

    private bool IsItemLine(LineEditor line) => AccountCodeOf(line) == "1300";

    /// <summary>
    /// القيمة الفعلية للبند المدين: بنود المخزون تُشتق من الكمية × التكلفة (نفس قاعدة الخدمة)،
    /// وبقية البنود من المبلغ المُدخل. يُستخدم للمجاميع وللإرسال معًا فلا يختلف ما يُعرض عن ما يُحفظ.
    /// </summary>
    private decimal EffectiveDebit(LineEditor line)
        => line.Debit > 0m
            ? Math.Round(line.Debit, 2)
            : IsItemLine(line) && line.Quantity > 0m && line.UnitCost > 0m
                ? Math.Round(line.Quantity * line.UnitCost, 2)
                : 0m;

    private decimal _totalDebit => Math.Round(_lines.Sum(EffectiveDebit), 2);
    private decimal _totalCredit => Math.Round(_lines.Sum(l => l.Credit), 2);
    private decimal _difference => Math.Abs(_totalDebit - _totalCredit);
    private bool _isBalanced => _totalDebit > 0 && _totalDebit == _totalCredit;

    protected override async Task OnInitializedAsync()
    {
        // الحسابات المتحركة (Leaf) فقط — القاعدة المحاسبية نفسها المطبَّقة في الخدمة.
        _accounts = await AccountService.GetLeafAccountsAsync();

        // قوائم التفصيل (تُحمّل مرة واحدة للحوار).
        _customers = await CustomerService.GetAllAsync();
        _suppliers = await SupplierService.GetAllAsync();
        _items = await ItemService.GetAllAsync();
        _warehouses = await WarehouseService.GetAllAsync();

        if (Batch is not null)
        {
            _fiscalYear = Batch.FiscalYear;
            _entryDate = Batch.EntryDate;
            _reference = Batch.Reference;
            _description = Batch.Description;
            _lines = Batch.Lines.Select(l => new LineEditor
            {
                AccountId = l.AccountId,
                Debit = l.DebitAmount,
                Credit = l.CreditAmount,
                CustomerId = l.CustomerId,
                SupplierId = l.SupplierId,
                ItemId = l.ItemId,
                WarehouseId = l.WarehouseId,
                Quantity = l.Quantity ?? 0m,
                UnitCost = l.UnitCost ?? 0m
            }).ToList();
        }

        while (_lines.Count < 2) AddLine();
    }

    private void AddLine() => _lines.Add(new LineEditor());

    private void RemoveLine(LineEditor line)
    {
        if (_lines.Count > 2) _lines.Remove(line);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task<string> CurrentUserIdAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        return auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
               ?? auth.User.Identity?.Name ?? "system";
    }

    private async Task SubmitAsync()
    {
        if (_busy) return;
        if (_form is not null) await _form.Validate();

        // تحقق أمامي مطابق لقواعد الخدمة (الخدمة هي الحارس النهائي خلفيًا).
        if (_fiscalYear < 1900 || _fiscalYear > 2100) { _error = Loc["OpeningBalanceYearRequired"]; return; }
        if (_entryDate is null) { _error = Loc["OpeningBalanceDateOutsideYear"]; return; }
        if (_entryDate.Value.Year != _fiscalYear) { _error = Loc["OpeningBalanceDateOutsideYear"]; return; }

        var effective = _lines.Where(l => l.Debit > 0 || l.Credit > 0).ToList();
        if (effective.Count < 2 || _lines.Any(l => l.AccountId == Guid.Empty && (l.Debit > 0 || l.Credit > 0)))
        {
            _error = Loc["OpeningBalanceLineRequired"];
            return;
        }
        if (!_isBalanced) { _error = Loc["OpeningBalanceNotBalanced", _difference.ToString("N2")]; return; }

        _error = null;
        _busy = true;
        try
        {
            var userId = await CurrentUserIdAsync();
            var inputs = effective.Select(l => new OpeningBalanceLineInput
            {
                AccountCode = AccountCodeOf(l) ?? string.Empty,
                // بنود المخزون: القيمة تُشتق من الكمية × التكلفة (نفس قاعدة الخدمة) فلا تختلف عن القيد.
                DebitAmount = EffectiveDebit(l),
                CreditAmount = l.Credit,
                // التفصيل: يُرسل فقط للحساب الذي يخصّه (والخدمة ترفض أي تفصيل في غير موضعه).
                CustomerCode = IsCustomerLine(l)
                    ? _customers.FirstOrDefault(c => c.Id == l.CustomerId)?.Code
                    : null,
                SupplierCode = IsSupplierLine(l)
                    ? _suppliers.FirstOrDefault(s => s.Id == l.SupplierId)?.Code
                    : null,
                ItemCode = IsItemLine(l) ? _items.FirstOrDefault(i => i.Id == l.ItemId)?.Code : null,
                WarehouseCode = IsItemLine(l) ? _warehouses.FirstOrDefault(w => w.Id == l.WarehouseId)?.Code : null,
                Quantity = IsItemLine(l) && l.Quantity > 0m ? l.Quantity : null,
                UnitCost = IsItemLine(l) ? l.UnitCost : null
            }).ToList();

            if (Batch is null)
            {
                await OpeningBalanceService.CreateDraftAsync(new CreateOpeningBalanceBatchDto
                {
                    FiscalYear = _fiscalYear,
                    EntryDate = _entryDate.Value,
                    Reference = _reference,
                    Description = _description,
                    Lines = inputs
                }, userId);
            }
            else
            {
                await OpeningBalanceService.UpdateDraftAsync(Batch.Id, new UpdateOpeningBalanceBatchDto
                {
                    EntryDate = _entryDate.Value,
                    Reference = _reference,
                    Description = _description,
                    Lines = inputs
                }, userId);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ErrorLocalizer.Resolve(Loc, ex);
        }
        finally
        {
            _busy = false;
        }
    }
}

