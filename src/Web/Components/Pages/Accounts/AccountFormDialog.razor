@* نموذج حوار لإضافة/تعديل حساب - يستخدم في MudDialog *@
@inject IStringLocalizer<SharedResources> Loc

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
            }
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_code"
                                  Label="@Loc["AccountCode"]"
                                  Required="true"
                                  RequiredError="@Loc["AccountCodeRequired"]"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="int"
                               @bind-Value="_accountType"
                               Label="@Loc["AccountType"]"
                               Required="true"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="int" Value="1">@Loc["AccountTypeAsset"]</MudSelectItem>
                        <MudSelectItem T="int" Value="2">@Loc["AccountTypeLiability"]</MudSelectItem>
                        <MudSelectItem T="int" Value="3">@Loc["AccountTypeEquity"]</MudSelectItem>
                        <MudSelectItem T="int" Value="4">@Loc["AccountTypeRevenue"]</MudSelectItem>
                        <MudSelectItem T="int" Value="5">@Loc["AccountTypeExpense"]</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_nameAr"
                                  Label="@Loc["AccountNameAr"]"
                                  Required="true"
                                  RequiredError="@Loc["NameArRequired"]"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_nameEn"
                                  Label="@Loc["AccountNameEn"]"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_parentAccountId"
                               Label="@Loc["ParentAccount"]"
                               Variant="Variant.Outlined"
                               T="Guid?"
                               Clearable="true"
                               HelperText="@Loc["ParentAccountHelper"]">
                        @foreach (var acc in ParentAccounts)
                        {
                            <MudSelectItem T="Guid?" Value="@acc.Id">@acc.Code - @acc.NameAr (@acc.LevelNameAr)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                        <strong>@Loc["AccountLevel"]:</strong> @CurrentLevelLabel
                    </MudAlert>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_description"
                                  Label="@Loc["Description"]"
                                  Lines="2"
                                  Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">@Loc["Cancel"]</MudButton>
        <MudButton OnClick="SubmitAsync"
                   Variant="Variant.Filled"
                   Color="Color.Primary">
            @(EditAccount is null ? Loc["Add"] : Loc["Edit"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public IAccountService AccountService { get; set; } = default!;
    [Parameter] public List<AccountDto> ParentAccounts { get; set; } = new();
    [Parameter] public AccountDto? EditAccount { get; set; }

    private MudForm? _form;
    private string _code = string.Empty;
    private int _accountType = 1;
    private string _nameAr = string.Empty;
    private string? _nameEn;
    private string? _description;
    private Guid? _parentAccountId;
    private string? _error;

    /// <summary>
    /// تسمية المستوى المعروضة في الحوار: للمستوى الحقيقي للحساب.
    ///  - عند التعديل: مستوى الحساب الفعلي (EditAccount.LevelNameAr).
    ///  - عند الإنشاء: المستوى المتوقع من الحساب الأب المختار (بلا أب ⇒ «المستوى الأول (الجد)»).
    /// الاشتقاق من الشجرة الفعلية عبر AccountTreeLevels — لا من رقم الحساب ولا من اسمه.
    /// </summary>
    private string CurrentLevelLabel
    {
        get
        {
            if (EditAccount is not null && _parentAccountId == EditAccount.ParentAccountId)
                return EditAccount.LevelNameAr;

            var parentLevel = _parentAccountId is null
                ? (int?)null
                : ParentAccounts.FirstOrDefault(a => a.Id == _parentAccountId)?.Level;

            return AccountTreeLevels.NameAr(AccountTreeLevels.ChildLevelOf(parentLevel));
        }
    }

    protected override void OnInitialized()
    {
        if (EditAccount is not null)
        {
            _code = EditAccount.Code;
            _accountType = EditAccount.AccountType;
            _nameAr = EditAccount.NameAr;
            _nameEn = EditAccount.NameEn;
            _description = EditAccount.Description;
            _parentAccountId = EditAccount.ParentAccountId;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        _error = null;
        try
        {
            if (EditAccount is null)
            {
                await AccountService.CreateAsync(new CreateAccountDto
                {
                    Code = _code,
                    NameAr = _nameAr,
                    NameEn = _nameEn,
                    AccountType = _accountType,
                    ParentAccountId = _parentAccountId,
                    Description = _description
                });
            }
            else
            {
                await AccountService.UpdateAsync(new UpdateAccountDto
                {
                    Id = EditAccount.Id,
                    Code = _code,
                    NameAr = _nameAr,
                    NameEn = _nameEn,
                    AccountType = _accountType,
                    ParentAccountId = _parentAccountId,
                    Description = _description,
                    IsActive = EditAccount.IsActive
                });
            }
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}